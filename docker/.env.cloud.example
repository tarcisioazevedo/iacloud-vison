# ──────────────────────────────────────────────────────────────
# IA Cloud Vision — Environment Variables (Tenant Deploy)
# Copie para .env e preencha os valores.
# ──────────────────────────────────────────────────────────────

# ─── Tenant ───────────────────────────────────────────────────
TENANT_SLUG=shopping-example
BASE_DOMAIN=iacloud.app

# ─── Licenciamento ────────────────────────────────────────────
ICV_LICENSE_KEY=your-license-key-here
ICV_PORTAL_URL=https://portal.iacloud.app

# ─── Hetzner Object Storage (S3) ─────────────────────────────
# Crie o bucket em: Hetzner Cloud Console → Object Storage
# Nome do bucket: icv-{TENANT_SLUG}  (ex: icv-shopping-example)
# Região: fsn1 (Falkenstein) | nbg1 (Nuremberg) | hel1 (Helsinki)
# Credenciais: Hetzner Cloud Console → Security → S3 Credentials → Generate
ICV_S3_BUCKET=icv-iacloud-vision
ICV_S3_ENDPOINT=https://fsn1.your-objectstorage.com
ICV_S3_ACCESS_KEY=VKLAU02WA8BI3Q9NAZOY
ICV_S3_SECRET_KEY=30mOY5dhchBfvMY5Li6G2zcROZorbpOU4IV6UmZN
# ICV_S3_REGION=  # Auto-detectado do endpoint. Sobreescreva se necessário.
# ICV_S3_QUOTA_GB=250  # Quota em GB (default: 250 = plano Free Hetzner)

# ─── Sync Interval ───────────────────────────────────────────
# Intervalo em segundos entre rodadas de sync (default: 300 = 5min)
ICV_SYNC_INTERVAL=300
