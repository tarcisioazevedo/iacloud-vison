{
  "name": "iacloud-vision-vsaas-backend",
  "version": "1.0.0",
  "description": "IA Cloud Vision — VSaaS B2B2B Backend",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint:capabilities": "tsx scripts/lint-capability-gates.ts",
    "lint:capabilities:strict": "CAPABILITY_LINT_STRICT=true tsx scripts/lint-capability-gates.ts",
    "lint:tenant-scope": "tsx scripts/lint-tenant-scope.ts",
    "lint:tenant-scope:strict": "TENANT_SCOPE_LINT_STRICT=true tsx scripts/lint-tenant-scope.ts",
    "prebuild": "npm run lint:capabilities:strict && npm run lint:tenant-scope",
    "seed:capabilities": "tsx src/scripts/seed-product-capabilities.ts",
    "db:migrate": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "lint": "eslint src --ext .ts",
    "test": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1038.0",
    "@aws-sdk/s3-request-presigner": "^3.1041.0",
    "@google-cloud/bigquery": "^7.9.1",
    "@google-cloud/storage": "^7.14.0",
    "@google-cloud/vision": "^4.3.2",
    "@google/generative-ai": "^0.21.0",
    "@prisma/client": "^5.22.0",
    "@sentry/node": "^10.51.0",
    "@sentry/profiling-node": "^10.51.0",
    "@sentry/react": "^10.51.0",
    "axios": "^1.15.2",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.7",
    "openai": "^4.104.0",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "uuid": "^11.0.5",
    "web-push": "^3.6.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.10.7",
    "@types/nodemailer": "^8.0.0",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "fast-check": "^4.8.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
