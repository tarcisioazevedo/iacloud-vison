  clienteFinal ClienteFinal @relation(fields: [clienteFinalId], references: [id], onDelete: Cascade)

  @@unique([clienteFinalId, module])
  @@index([clienteFinalId])
}

/// Magic-link de acesso ao Portal Cliente-Final (Sprint CF.4 — B2B2B).
///
/// O integrador gera um token (POST /clientes-finais/:id/portal-token) e envia
/// o link/QR ao cliente final. O cliente abre `/portal?token=...`, o backend
/// troca por uma sessão (JWT scoped a clienteFinalId) e redireciona pra view
/// reduzida (Live, Eventos, Logs — só do que é dele).
///
/// Segurança:
///   - Armazenamos só o SHA-256 do token (nunca o plaintext).
///   - `expiresAt` curto (24h default) — após exchange, vira sessão JWT.
///   - `lastUsedAt` permite auditoria; tokens podem ser revogados a qualquer
///     hora pelo integrador (revoked=true).
///   - Single-use opcional: `singleUse=true` invalida após primeiro exchange.
///   - `createdBy` rastreia o usuário do integrador que emitiu (auditoria).
model PortalAccessToken {
  id             String    @id @default(uuid())
  clienteFinalId String
  /// SHA-256 hex do token plaintext. Plaintext nunca persiste no servidor.
  tokenHash      String    @unique
  /// Quando o token expira pra exchange. Default 24h após emissão.
  expiresAt      DateTime
  /// Quando alguém trocou o token por uma sessão. Null = nunca usado.
  lastUsedAt     DateTime?
  /// Se true, token vira inválido após o primeiro exchange.
  singleUse      Boolean   @default(false)
  /// Revogação manual pelo integrador (sem deletar pra preservar audit trail).
  revoked        Boolean   @default(false)
  /// User ID do integrador que emitiu (FK soft — User pode ser de qualquer
  /// integrador admin; preferimos não cascade pra preservar audit).
  createdBy      String
  /// Label opcional pra distinguir tokens ("recepção", "celular do gerente").
  label          String?
  createdAt      DateTime  @default(now())

  clienteFinal ClienteFinal @relation(fields: [clienteFinalId], references: [id], onDelete: Cascade)

  @@index([clienteFinalId])
  @@index([expiresAt])
}

/// Política de retenção de evidências (GCS lifecycle)
model EvidenceRetentionPolicy {
  id            String    @id @default(uuid())
  integradorId  String? // null = política global
  gcsBucket     String
  ttlHours      Int       @default(72) // 72h padrão LGPD
  lifecycleRule Json // regra GCS JSON para aplicar via API
  lastAppliedAt DateTime?
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// =============================================================================
// LOGS — sistema sofisticado de observabilidade (Frigate-style)
// =============================================================================

/// Log por câmera — eventos operacionais (FFmpeg, detector, motion, zone...)
model CameraLog {
  id            String          @id @default(uuid())
  cameraId      String
  level         CameraLogLevel
  source        CameraLogSource
  message       String          @db.Text
  detailsJson   Json?
  correlationId String? // para agrupar logs de uma mesma operação
  durationMs    Int? // duração quando aplicável (ex.: chamada Vertex)
  errorCode     String?
  stackTrace    String?         @db.Text
  // contexto do evento
  eventId       String?
  zoneId        String?
  recordedAt    DateTime        @default(now())

  camera Camera @relation(fields: [cameraId], references: [id], onDelete: Cascade)

  @@index([cameraId, recordedAt])
  @@index([level, recordedAt])
  @@index([source, recordedAt])
  @@index([errorCode])
}

/// Log de auditoria do pipeline RTMP push de ingestão.
///
/// Cada vez que uma câmera (ou outro publisher) tenta empurrar pro nosso
/// endpoint `rtmp://ingest.iacloud.com.br/live/<key>`, gravamos um evento.
/// Permite ver QUEM tentou conectar, quando, com qual key/path, e se foi
/// aceito ou rejeitado.
///
/// Acesso restrito a SUPER_ADMIN — o endpoint público de ingest não tem
/// segregação por tenant (qualquer câmera de qualquer cliente cai no
/// mesmo socket). Auditoria é cross-tenant por natureza, então só admin
/// global enxerga.
model IngestLog {
  id          String      @id @default(uuid())
  ts          DateTime    @default(now())
  event       IngestEvent
  /// Path completo recebido (ex: "live/abc-key-xyz", "myapp/streamname").
  /// Útil pra debug quando câmera usa firmware que muda o path padrão.
  streamPath  String
  /// Endereço IP de origem (cliente que abriu a conexão TCP). Em produção
  /// atrás de proxy reverso, é o X-Forwarded-For do RTMP server à frente.
  remoteAddr  String?
  /// Quando event=AUTH_OK ou PUBLISH_*: câmera resolvida pelo path/key.
  /// Null quando event=AUTH_FAIL/UNKNOWN_PATH (não conseguimos identificar).
  cameraId    String?
  camera      Camera?     @relation(fields: [cameraId], references: [id], onDelete: SetNull)
  /// Bytes recebidos (snapshot ou total da sessão). Útil pra detectar
  /// streams "fantasma" que conectam mas não enviam payload.
  bytesIn     BigInt?
  /// Detalhes técnicos extras (codec detectado, FPS, mensagem de erro etc).
  detailsJson Json?

  @@index([ts])
  @@index([event, ts])
  @@index([cameraId, ts])
  @@index([remoteAddr])
}

/// Log de sistema (sem câmera) — autenticação, API, jobs, GCP
model SystemLog {
  id          String          @id @default(uuid())
  level       CameraLogLevel
  source      CameraLogSource
  message     String          @db.Text
  detailsJson Json?

  // Contexto de tenant (opcional)
  integradorId   String?
  clienteFinalId String?
  siteId         String?
  edgeNodeId     String?
  userId         String?

  // Contexto técnico
  correlationId String?
  requestId     String?
  method        String?
  path          String?
  statusCode    Int?
  durationMs    Int?
  ipAddress     String?
  userAgent     String?
  errorCode     String?
  stackTrace    String? @db.Text

  recordedAt DateTime @default(now())

  @@index([level, recordedAt])
  @@index([source, recordedAt])
  @@index([integradorId, recordedAt])
  @@index([clienteFinalId, recordedAt])
  @@index([errorCode])
  @@index([correlationId])
}

/// Histórico de testes de conexão RTSP/ONVIF
model CameraStreamTest {
  id           String   @id @default(uuid())
  cameraId     String
  success      Boolean
  stage        String // "dns" | "tcp" | "rtsp_describe" | "rtsp_play" | "onvif_probe" | "ffmpeg_probe"
  resolution   String?
  fps          Float?
  codec        String?
  bitrateKbps  Int?
  latencyMs    Int?
  errorCode    String?
  errorMessage String?  @db.Text
  rawOutput    String?  @db.Text
  testedAt     DateTime @default(now())

  camera Camera @relation(fields: [cameraId], references: [id], onDelete: Cascade)

  @@index([cameraId, testedAt])
}

// =============================================================================
// HLS PLAYBACK — gravação contínua em segmentos .ts
// =============================================================================
//
// Cada câmera com recordEnabled=true tem um ffmpeg dedicado rodando em loop
// gerando segmentos de 4-10s (HLS-friendly). Cada segmento fechado gera 1
// linha aqui. O endpoint /playback/:id/manifest.m3u8 lê esta tabela com
// filtro de tempo + tenant scope e devolve um m3u8 dinâmico apontando pra
// /playback/:id/segments/<id>.ts (servidos com auth via ticket).
//
// Por que tabela ao invés de listar arquivos:
//   - Listar arquivos no disco/S3 a cada query = lento (>10ms por câmera)
//   - Tabela com index (cameraId, startedAt) faz range queries em <1ms
//   - Job de retenção apenas DELETE FROM (rápido) + remoção async dos arquivos
//   - Permite metadados úteis (codec, bitrate efetivo, sizeBytes pra
//     billing futuro) sem stat() em cada arquivo
model RecordingSegment {
  id          String   @id @default(uuid())
  cameraId    String
  /// Início do segmento (UTC). Index principal pra range queries.
  startedAt   DateTime
  /// Fim do segmento (UTC). startedAt + durationSec ≈ endedAt, mas
  /// guardamos explícito porque ffmpeg pode encerrar antes (truncado).
  endedAt     DateTime
  durationSec Float // duration real em segundos (pode ser 3.97 ao invés de 4.0)
  sizeBytes   BigInt // tamanho do .ts em bytes (storage billing)
  /// Path relativo dentro do storage. Ex: "cam-abc/2026-04-26/14-32-04.ts"
  /// Composição com STORAGE_BASE_PATH (env) dá o caminho final.
  storagePath String
  codec       String   @default("h264") // futuro: h265 quando ffmpeg-edge suportar
  /// Resolução observada no segmento (debug + UI mostra "1920x1080" no scrubber).
  width       Int?
  height      Int?
  fps         Int?
  /// Marcadores rápidos para a timeline e filtro de motion search (Alt 3 prefilter).
  hasMotion   Boolean  @default(false)
  hasEvent    Boolean  @default(false)
  /// URL da sprite sheet (1 thumb/s) para scrubbing e busca por diff (Alt 2).
  spriteUrl   String?

  camera           Camera             @relation(fields: [cameraId], references: [id], onDelete: Cascade)
  bookmarks        Bookmark[]
  detectionFrames  DetectionFrame[]

  @@index([cameraId, startedAt])
  @@index([endedAt])
  @@index([cameraId, hasMotion, startedAt])
}

// =============================================================================
// BOOKMARKS — marcação de eventos no vídeo (manual + automática)
// =============================================================================

enum BookmarkAutoType {
  MANUAL
  MOTION
  EVENT
  DOWNLOAD
  EXPORT
}

model Bookmark {
  id          String           @id @default(uuid())
  cameraId    String
  segmentId   String?
  tenantId    String
  title       String
  color       String           @default("#F59E0B")
  startAt     DateTime
  endAt       DateTime?
  notes       String?
  autoType    BookmarkAutoType @default(MANUAL)
  createdById String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  camera  Camera            @relation(fields: [cameraId], references: [id], onDelete: Cascade)
  segment RecordingSegment? @relation(fields: [segmentId], references: [id], onDelete: SetNull)

  @@index([cameraId, startAt])
  @@index([tenantId])
  @@index([autoType])
}

// =============================================================================
// RECORDING SCHEDULE — agendamento por dia/hora/modo
// =============================================================================

enum RecordingScheduleMode {
  ALWAYS
  MOTION
  EVENT
  MOTION_AND_EVENT
  DISABLED
}

model RecordingSchedule {
  id        String                @id @default(uuid())
  cameraId  String
  /// 0=Dom, 1=Seg, ..., 6=Sab. Use 7 para "todos os dias"
  dayOfWeek Int
  hourStart Int
  hourEnd   Int
  mode      RecordingScheduleMode @default(ALWAYS)
  createdAt DateTime              @default(now())
  updatedAt DateTime               @updatedAt

  camera Camera @relation(fields: [cameraId], references: [id], onDelete: Cascade)

  @@unique([cameraId, dayOfWeek, hourStart])
  @@index([cameraId])
}

// =============================================================================
// DETECTION FRAME — bounding boxes para motion search por zona (Alt 3)
// =============================================================================

model DetectionFrame {
  id         String   @id @default(uuid())
  cameraId   String
  segmentId  String?
  timestamp  DateTime
  objectType String
  bboxX      Float
  bboxY      Float
  bboxW      Float
  bboxH      Float
  confidence Float?
  trackId    String?
  createdAt  DateTime @default(now())

  camera  Camera            @relation(fields: [cameraId], references: [id], onDelete: Cascade)
  segment RecordingSegment? @relation(fields: [segmentId], references: [id], onDelete: SetNull)

  @@index([cameraId, timestamp])
  @@index([cameraId, objectType, timestamp])
}

// =============================================================================
// EXPORT AUDIT — auditoria de exportações de mídia
// =============================================================================

enum ExportAuditType {
  SNAPSHOT
  RECORDING
  BULK
  MOSAIC
  PRINT
}

model ExportAudit {
  id            String          @id @default(uuid())
  tenantId      String
  userId        String?
  userEmail     String?
  cameraIds     String[]        @default([])
  fromAt        DateTime?
  toAt          DateTime?
  exportType    ExportAuditType
  fileSizeBytes BigInt?
  fileCount     Int             @default(1)
  destination   String?
  certificateId String?
  ipAddress     String?
  userAgent     String?
  metadata      Json?
  createdAt     DateTime        @default(now())

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([userId])
  @@index([exportType])
}

// =============================================================================
// MEDIA CERTIFICATE — assinatura digital HMAC para autenticidade
// =============================================================================

enum MediaCertificateType {
  SNAPSHOT
  RECORDING
  PRINT
  MOSAIC_EXPORT
}

model MediaCertificate {
  id         String               @id @default(uuid())
  tenantId   String
  cameraId   String?
  type       MediaCertificateType
  capturedAt DateTime?
  exportedAt DateTime             @default(now())
  exportedBy String?
  sha256     String
  signature  String               @unique
  fileSize   BigInt?
  fileName   String?
  metadata   Json?
  createdAt  DateTime             @default(now())

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([cameraId])
}

// =============================================================================
// FACE RECOGNITION — biblioteca de identidades + eventos (Vertex AI)
// =============================================================================

/// Identidade cadastrada — pessoa conhecida (funcionário, visitante, VIP)
model FaceIdentity {
  id             String   @id @default(uuid())
  clienteFinalId String // multi-tenant: library por cliente final
  name           String
  externalId     String? // matrícula, CPF anonimizado, ID corporativo
  role           String? // "employee" | "visitor" | "vip" | "blacklist"
  department     String?
  email          String?
  phone          String?
  notes          String?  @db.Text
  thumbnailUrl   String? // thumbnail GCS para UI (recortada)
  active         Boolean  @default(true)
  alertOnMatch   Boolean  @default(false) // dispara alerta quando reconhecido
  alertOnMissing Boolean  @default(false) // dispara alerta após N dias sem reconhecimento
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  embeddings   FaceEmbedding[]
  events       FaceRecognitionEvent[]
  // Relation explícita para suportar filtro multi-tenant via integrador
  // (tenantFilter em /faces/identities) — antes faltava e quebrava silencioso.
  clienteFinal ClienteFinal           @relation(fields: [clienteFinalId], references: [id])

  @@index([clienteFinalId, active])
  @@index([externalId])
  @@index([role])
}

/// Embedding vetorial de um rosto (Vertex AI multimodal embeddings)
model FaceEmbedding {
  id             String   @id @default(uuid())
  faceIdentityId String
  provider       String // "vertex_ai" | "frigate_arcface" | "insightface"
  modelVersion   String // "multimodalembedding@001" | "arcface-r100" | ...
  vectorJson     Json // array de floats (dim depende do modelo)
  vectorDim      Int
  sourceImageUrl String? // GCS URL da imagem de origem
  quality        Float? // 0-1 (blur, pose, occlusion)
  createdAt      DateTime @default(now())

  faceIdentity FaceIdentity @relation(fields: [faceIdentityId], references: [id], onDelete: Cascade)

  @@index([faceIdentityId])
  @@index([provider, modelVersion])
}

/// Evento de reconhecimento facial — match de um rosto detectado com biblioteca
model FaceRecognitionEvent {
  id             String          @id @default(uuid())
  cameraId       String
  faceIdentityId String? // null = UNKNOWN
  status         FaceMatchStatus
  matchScore     Float? // 0-1
  unknownScore   Float?
  capturedAt     DateTime
  processedAt    DateTime        @default(now())
  bboxJson       Json? // {x,y,w,h} normalizado
  cropGcsKey     String? // GCS da face crop (TTL LGPD)
  frameGcsKey    String? // GCS do frame completo
  gender         String?
  ageRange       String?
  emotion        String?
  quality        Float?
  pose           Json? // {yaw, pitch, roll}
  reviewItemId   String?

  camera       Camera        @relation(fields: [cameraId], references: [id], onDelete: Cascade)
  faceIdentity FaceIdentity? @relation(fields: [faceIdentityId], references: [id])
  reviewItem   ReviewItem?   @relation(fields: [reviewItemId], references: [id])

  @@index([cameraId, capturedAt])
  @@index([faceIdentityId, capturedAt])
  @@index([status, capturedAt])
}

// =============================================================================
// LPR — License Plate Recognition (placas conhecidas + eventos)
// =============================================================================

/// Placa veicular conhecida — cadastro do cliente
model LicensePlate {
  id             String        @id @default(uuid())
  clienteFinalId String
  plate          String // "ABC1D23" (normalizada, sem hífen)
  label          String? // nome do proprietário ou descrição
  category       PlateCategory @default(AUTHORIZED)
  vehicleModel   String?
  vehicleColor   String?
  vehicleType    String? // "car"|"motorcycle"|"truck"|"bus"
  ownerName      String?
  ownerDocument  String? // CPF/CNPJ (encrypted na app layer)
  validFrom      DateTime?
  validUntil     DateTime?
  active         Boolean       @default(true)
  alertOnMatch   Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  events       LicensePlateEvent[]
  // Relation explícita com ClienteFinal para permitir filtro multi-tenant
  // via integrador (necessário em /plates listagem para INTEGRADOR_ADMIN).
  clienteFinal ClienteFinal        @relation(fields: [clienteFinalId], references: [id])

  @@unique([clienteFinalId, plate])
  @@index([clienteFinalId, active])
  @@index([category])
  @@index([plate])
}

/// Evento de reconhecimento de placa
model LicensePlateEvent {
  id             String   @id @default(uuid())
  cameraId       String
  licensePlateId String? // null = placa desconhecida
  detectedPlate  String // placa reconhecida por OCR
  matchDistance  Int? // Levenshtein para match aproximado
  ocrScore       Float
  vehicleType    String?
  vehicleColor   String?
  direction      String? // "IN" | "OUT"
  capturedAt     DateTime
  processedAt    DateTime @default(now())
  bboxJson       Json?
  cropGcsKey     String?
  frameGcsKey    String?
  reviewItemId   String?

  camera       Camera        @relation(fields: [cameraId], references: [id], onDelete: Cascade)
  licensePlate LicensePlate? @relation(fields: [licensePlateId], references: [id])
  reviewItem   ReviewItem?   @relation(fields: [reviewItemId], references: [id])

  @@index([cameraId, capturedAt])
  @@index([detectedPlate])
  @@index([licensePlateId, capturedAt])
}

// =============================================================================
// AUDIO detection events
// =============================================================================

model AudioDetectionEvent {
  id           String   @id @default(uuid())
  cameraId     String
  label        String // "bark" | "scream" | "glass_breaking" | "fire_alarm" | "siren"
  score        Float
  volumeDb     Float?
  capturedAt   DateTime
  durationMs   Int?
  reviewItemId String?
  clipGcsKey   String?

  camera     Camera      @relation(fields: [cameraId], references: [id], onDelete: Cascade)
  reviewItem ReviewItem? @relation(fields: [reviewItemId], references: [id])

  @@index([cameraId, capturedAt])
  @@index([label, capturedAt])
}

// =============================================================================
// REVIEW — agrupamento de eventos (Alerts vs Detections) estilo Frigate 0.14+
// =============================================================================

model ReviewItem {
  id          String         @id @default(uuid())
  cameraId    String
  severity    ReviewSeverity
  status      ReviewStatus   @default(PENDING)
  title       String
  description String?        @db.Text
  startAt     DateTime
  endAt       DateTime?
  durationSec Int?

  // Contexto agregado
  objectsJson     Json? // lista de objetos envolvidos
  zonesJson       Json?
  thumbnailGcsKey String?
  clipGcsKey      String?

  // GenAI summary
  genaiSummary  String? @db.Text
  genaiProvider String?
  genaiModel    String?

  // Acknowledgment
  acknowledgedAt DateTime?
  acknowledgedBy String?
  resolvedAt     DateTime?
  resolvedBy     String?
  resolution     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  camera      Camera                 @relation(fields: [cameraId], references: [id], onDelete: Cascade)
  faceEvents  FaceRecognitionEvent[]
  plateEvents LicensePlateEvent[]
  audioEvents AudioDetectionEvent[]

  @@index([cameraId, startAt])
  @@index([status, startAt])
  @@index([severity, startAt])
}

/// Regra de alerta configurável por câmera — "se person em zona X por mais de Y segundos"
model CameraAlertRule {
  id          String  @id @default(uuid())
  cameraId    String
  name        String
  description String?
  enabled     Boolean @default(true)

  // DSL declarativa
  triggerType    String // "ZONE_OCCUPANCY" | "LOITERING" | "TRIPWIRE" | "PPE_VIOLATION" |
  // "FACE_MATCH" | "FACE_UNKNOWN" | "LPR_BLACKLIST" | "AUDIO_DETECT" |
  // "MOTION_AREA" | "OBJECT_CLASS" | "QUEUE_OVERFLOW"
  conditionsJson Json // parâmetros específicos do trigger

  // Janelas
  scheduleJson Json? // horários ativos ("business_hours", cron)
  cooldownSec  Int?  @default(60)

  // Ações
  severity          ReviewSeverity @default(ALERT)
  notifyEmail       String?
  notifyWebhookUrl  String?
  notifyPushEnabled Boolean        @default(false)
  notifyMqttTopic   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  camera Camera @relation(fields: [cameraId], references: [id], onDelete: Cascade)

  @@index([cameraId, enabled])
  @@index([triggerType])
}

// =============================================================================
// SEMANTIC SEARCH — embeddings de eventos para busca por linguagem natural
// =============================================================================

// =============================================================================
// SPRINT Q.1 — WEB PUSH (VAPID) — assinaturas browser por usuário/integrador
// =============================================================================
//
// Modelo Frigate-inspired: o browser cria uma PushSubscription assinada com
// VAPID e envia o JSON ao backend. Backend persiste e dispara payloads via
// `web-push` lib quando há eventos de severidade configurada. Resposta 410
// Gone do provedor (FCM/Mozilla/APNs) PURGA a subscription automaticamente
// (ver lib/webpush.ts).
//
// Multi-tenant: cada subscription pertence a um actor (User|Integrador|SuperAdmin).
// Para desktop com várias abas, p256dh é único — usado como dedupe key natural.
model PushSubscription {
  id           String  @id @default(uuid())
  // Actor — exatamente UM dos três é preenchido (mirror de AuditLog).
  superAdminId String?
  integradorId String?
  userId       String?

  // Endpoint do navegador — geralmente https://fcm.googleapis.com/...
  endpoint     String    @db.Text
  // Chaves p256dh/auth do PushSubscription (Web Push spec) em base64url.
  p256dh       String
  authKey      String // (renomeado de "auth" pra evitar choque com Prisma reserved)
  // User-Agent na hora da subscrição (UI mostra "Chrome no Windows", etc.)
  userAgent    String?   @db.Text
  // Ativa? false = soft-delete após 410 Gone do FCM
  active       Boolean   @default(true)
  // Última tentativa de envio (sucesso ou falha) e erro (se houver)
  lastUsedAt   DateTime?
  lastErrorAt  DateTime?
  lastErrorMsg String?
  failureCount Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([p256dh])
  @@index([superAdminId])
  @@index([integradorId])
  @@index([userId])
  @@index([active])
}

// =============================================================================
// SPRINT S — SEMANTIC TRIGGERS (Frigate 0.17.1 style)
// =============================================================================
//
// Conceito: usuário envia uma imagem ou descreve em texto o que quer detectar.
// O backend gera um embedding multimodal (Vertex multimodalembedding@001 ou
// CLIP local quando edge). A cada novo evento (review item, snapshot), comparamos
// cosine distance contra os embeddings cadastrados e disparamos ações.
//
// Diferencia da nossa /semantic-search atual: triggers são REATIVOS (push-driven),
// /semantic-search é PULL (usuário consulta).
enum SemanticTriggerSourceType {
  IMAGE // upload de imagem (preview embedding)
  TEXT // prompt textual ("homem com camiseta vermelha")
  THUMBNAIL_REF // re-uso de thumbnail de evento existente
}

enum SemanticTriggerActionType {
  WEBHOOK // POST com HMAC-SHA256
  NOTIFY // WebPush para subscriptions do tenant
  RECORD // forçar recording mesmo sem motion
  SIREN // publica em iacv/<integ>/<cam>/siren via MQTT
  REVIEW_FLAG // marca review item como ALERT
}

model SemanticTrigger {
  id             String  @id @default(uuid())
  // Multi-tenant: trigger pertence a um cliente final (lib é por cliente).
  clienteFinalId String
  name           String
  description    String? @db.Text
  enabled        Boolean @default(true)

  // Restrição opcional de câmeras (vazio = todas as câmeras do cliente).
  cameraIdsJson Json? // ["uuid", "uuid"]

  // Fonte do embedding
  sourceType     SemanticTriggerSourceType
  sourceImageUrl String? // GCS/HTTP da imagem original (para revisão humana)
  sourceText     String?                   @db.Text

  // Embedding gerado a partir da fonte
  embeddingProvider String // "vertex_multimodal" | "openai_clip" | "synthetic"
  embeddingModel    String
  embeddingVector   Json // float[768] ou float[512]
  embeddingDim      Int

  // Threshold de match — cosine similarity mínima para disparar
  threshold   Float @default(0.78)
  // Cooldown em segundos por (trigger,camera) para evitar disparos em rajada
  cooldownSec Int   @default(120)

  // Ações configuradas (uma ou mais)
  actionsJson Json // [{type:"WEBHOOK", url:"...", secret:"..."}, {type:"NOTIFY"}]

  // Janela de horário ativa (cron-like) — null = 24/7
  scheduleJson Json?

  // Estatísticas
  hitsCount Int       @default(0)
  lastHitAt DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  hits SemanticTriggerHit[]

  @@index([clienteFinalId, enabled])
  @@index([enabled, lastHitAt])
}

model SemanticTriggerHit {
  id                  String  @id @default(uuid())
  triggerId           String
  cameraId            String
  reviewItemId        String?
  semanticEmbeddingId String?

  // Score do match (cosine similarity)
  score       Float
  // Snapshot que gerou o match (URL pública ou GCS key)
  snapshotKey String?

  // Resultado das ações executadas
  actionsRunJson Json? // [{type:"WEBHOOK", status:200, durationMs:120}]
  // Estado pós-execução
  delivered      Boolean @default(false)
  errorMessage   String? @db.Text

  capturedAt  DateTime
  processedAt DateTime @default(now())

  trigger SemanticTrigger @relation(fields: [triggerId], references: [id], onDelete: Cascade)

  @@index([triggerId, capturedAt])
  @@index([cameraId, capturedAt])
}

model SemanticEmbedding {
  id           String  @id @default(uuid())
  cameraId     String
  eventId      String? // link opcional a AnalyticsEvent
  reviewItemId String?

  // Conteúdo semântico
  thumbnailGcsKey String?
  caption         String?  @db.Text // descrição (humana ou GenAI)
  tags            String[] @default([])

  // Embedding
  provider     String // "vertex_multimodal" | "vertex_text" | "openai"
  modelVersion String
  vectorJson   Json // array float[768] (Vertex) ou float[1408]
  vectorDim    Int

  capturedAt DateTime
  createdAt  DateTime @default(now())

  camera Camera @relation(fields: [cameraId], references: [id], onDelete: Cascade)

  @@index([cameraId, capturedAt])
  @@index([provider, modelVersion])
}

// =============================================================================
// LEAD — funil comercial pré-tenant (CRM interno do Fabricante)
// =============================================================================
//
// Lote 0 do onboarding. Quando alguém clica em "Solicitar acesso GRÁTIS" na
// tela de login, NÃO criamos tenant: criamos um Lead. O Admin global trabalha
// o lead e, quando aprovado, gera DemoInvite (Lote 1) que vira Integrador
// real ao ser consumido.
//
// `kind` separa duas portas de entrada:
//   - INTEGRADOR    : empresa que vende monitoramento; vira Integrador novo
//   - CLIENTE_FINAL : cliente que quer monitorar; é alocado como Cliente Final
//                     do tenant IACV (Integrador { isIacvOwn: true })
//
// `status` segue o funil clássico:
//   NEW → CONTACTED → DEMO_SENT → CONVERTED  (caminho feliz)
//                                ↘ LOST       (frio, não fechou)
// =============================================================================

enum FollowUpType {
  NOTE
  CALL
  EMAIL
  WHATSAPP
  MEETING
  TASK
}

enum LeadKind {
  INTEGRADOR
  CLIENTE_FINAL
}

enum LeadStatus {
  NEW
  CONTACTED
  DEMO_SENT
  NEGOTIATION   // proposta enviada, em negociação
  CONVERTED
  LOST
}

model Lead {
  id String @id @default(uuid())

  kind   LeadKind
  status LeadStatus @default(NEW)

  // Contato
  contactName  String
  contactEmail String
  contactPhone String?
  contactRole  String? // cargo (Diretor, Gerente, etc.)

  // Empresa (obrigatório p/ INTEGRADOR; opcional p/ CLIENTE_FINAL)
  companyName      String?
  companyTradeName String?
  cnpj             String? // 14 dígitos sem máscara; null p/ alguns CLIENTE_FINAL
  city             String?
  state            String? // UF 2 letras

  // Qualificação (Monuv-style)
  // INTEGRADOR: já possui central de monitoramento de alarmes?
  alarmCentral String? // 'YES' | 'NO' | 'BUILDING' (free-form pra evolução)
  // INTEGRADOR/CLIENTE: faixa de quantidade de câmeras
  cameraVolume String? // 'LT_50' | '50_500' | '500_2000' | 'GT_2000'
  // Estágio do projeto/demanda (livre)
  projectStage String?

  // Observações livres do lead ou do operador
  message String? @db.Text
  notes   String? @db.Text // notas internas do Admin global

  // Origem: 'login_cta' | 'demo_link' | 'manual' | 'website_contact'
  source String @default("login_cta")

  // CRM interno
  assignedToUserId        String? // user que está trabalhando o lead
  contactedAt             DateTime?
  demoSentAt              DateTime?
  convertedAt             DateTime?
  // Quando convertido, aponta o tenant gerado (Integrador novo OU
  // ClienteFinal alocado ao tenant IACV).
  convertedIntegradorId   String?
  convertedClienteFinalId String?
  lostReason              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Lote 1: convites emitidos por este lead (varios podem ser regerados).
  demoInvites DemoInvite[]
  // CRM: histórico de atividades (ligações, notas, e-mails, reuniões…).
  followUps   LeadFollowUp[]
  // Histórico de mudanças de etapa do funil (audit trail).
  statusHistory LeadStatusHistory[]

  @@index([status, createdAt])
  @@index([kind, status])
  @@index([cnpj])
  @@index([contactEmail])
}

// Audit trail granular de mudanças de status de Lead.
// Sempre persistido em PATCH /leads/:id quando status muda — independente do
// actor ser SalesUser ou admin global. Visível no LeadDrawer.
model LeadStatusHistory {
  id              String    @id @default(uuid())
  leadId          String
  fromStatus      String?   // null no primeiro registro (criação)
  toStatus        String
  reason          String?   // motivo de perda, observação livre etc.
  changedByUserId String?   // null se a mudança veio de hook automático/sistema
  changedByName   String?   // denormalizado pra render rápido sem JOIN
  changedByRole   String?   // SUPER_ADMIN | INTEGRADOR_ADMIN | SDR | …
  source          String    @default("manual") // 'manual' | 'auto' | 'hook' | 'cron'
  createdAt       DateTime  @default(now())

  lead            Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt(sort: Desc)])
}

// =============================================================================
// COMERCIAL — Equipe de vendas + Atividades + Oportunidades + Score
// (Sprint Comercial Hub — refatoração comercial)
// =============================================================================

enum SalesRole {
  SDR        // Sales Development Rep — prospecção
  AE         // Account Executive — fechamento
  CS         // Customer Success — pós-venda
  MANAGER    // gerente comercial
  DIRECTOR   // diretor/CCO
}

model SalesUser {
  id        String   @id @default(uuid())
  userId    String   @unique  // FK User existente (relação opcional não modelada para evitar circular)
  name      String
  email     String   @unique
  role      SalesRole
  avatar    String?
  hireDate  DateTime @default(now())
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  goals         SalesGoal[]
  activities    SalesActivity[]
  opportunities SalesOpportunity[]

  @@index([role, active])
}

enum GoalMetric {
  CALLS              // número de calls/dia
  QUALIFIED_LEADS    // leads qualificados
  DEMOS_SENT         // demos enviadas
  DEALS_CLOSED       // deals fechados
  CLOSED_MRR         // MRR fechado (R$)
  REVENUE            // receita total
}

// SalesPermission — permissão por tela (default por role OU override individual)
model SalesPermission {
  id          String   @id @default(uuid())
  role        SalesRole?  // se preenchido = default da role; null = override individual
  salesUserId String?     // se preenchido = override individual; null = default da role
  screen      String   // 'executive'|'pipeline'|'demos'|'opportunities'|'activities'|'team'|'materials'|'modules'|'config'
  level       String   // 'NONE'|'VIEW'|'EDIT'|'ADMIN'
  changedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([role, screen])
  @@unique([salesUserId, screen])
  @@index([role])
  @@index([salesUserId])
}

// =============================================================================
// NOTIFICATIONS — preferências granulares + log de envio
// =============================================================================
//
// NotificationPreference: 1 row por User OU por SuperAdmin (XOR), cobre canais
// (push/email/whatsapp/sse) e permite mapeamento granular event×canal.
//
// NotificationLog: append-only de cada tentativa, para auditoria e dedupe.
// =============================================================================

model NotificationPreference {
  id              String   @id @default(uuid())
  userId          String?  @unique
  superAdminId    String?  @unique
  pushEnabled     Boolean  @default(true)
  emailEnabled    Boolean  @default(true)
  whatsappEnabled Boolean  @default(false) // opt-in explícito (LGPD)
  whatsappPhone   String?  // E.164; se null, usa User.phone/SuperAdmin.phone
  quietHoursStart Int      @default(22)    // 22h
  quietHoursEnd   Int      @default(7)     // 7h
  // Map { eventName: ['push','email','whatsapp'] }. Override do default por evento.
  // Se ausente uma chave, usa default do código.
  eventChannels   Json     @default("{}")
  dailyDigest     Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
  @@index([superAdminId])
}

model NotificationDeliveryLog {
  id                    String   @id @default(uuid())
  recipientUserId       String?
  recipientSuperAdminId String?
  event                 String   // 'NEW_LEAD' | 'HOT_LEAD' | 'DEMO_APPROVED' | ...
  channel               String   // 'push' | 'email' | 'whatsapp' | 'sse'
  status                String   // 'sent' | 'failed' | 'skipped_pref' | 'skipped_quiet' | 'deduped'
  dedupeKey             String?  // hash usado para deduplicação
  payloadJson           Json?
  errorMsg              String?
  createdAt             DateTime @default(now())

  @@index([recipientUserId, createdAt(sort: Desc)])
  @@index([recipientSuperAdminId, createdAt(sort: Desc)])
  @@index([event, channel, createdAt(sort: Desc)])
  @@index([dedupeKey, createdAt(sort: Desc)])
}

// SalesConfig — singleton de configuração do Hub Comercial
model SalesConfig {
  id                 String   @id @default("singleton")
  slaDemoBusinessDays Int     @default(1)
  roundRobinEnabled  Boolean  @default(true)
  pushNotifications  Boolean  @default(true)
  customLostReasons  String[] @default([])
  defaultGoalsJson   Json?    // { "SDR": { "CALLS": 600, "QUALS": 50 } }
  updatedBy          String?
  updatedAt          DateTime @updatedAt @default(now())
}

model SalesGoal {
  id          String     @id @default(uuid())
  salesUserId String
  period      DateTime   // primeiro dia do mês de referência
  metric      GoalMetric
  target      Float
  actual      Float      @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  salesUser   SalesUser  @relation(fields: [salesUserId], references: [id], onDelete: Cascade)
  @@unique([salesUserId, period, metric])
  @@index([period])
}

enum ActivityType {
  CALL
  EMAIL
  WHATSAPP
  MEETING
  NOTE
  TASK
  PROPOSAL_SENT
  DEMO_DONE
}

// SalesActivity — feed unificado de atividades comerciais (calls, emails, etc).
// Atrelado a um Lead OU a um Integrador (no caso de cross-sell na base instalada).
model SalesActivity {
  id           String       @id @default(uuid())
  salesUserId  String
  leadId       String?
  integradorId String?      // se for atividade em conta existente (cross-sell)
  opportunityId String?
  type         ActivityType
  durationSec  Int?
  outcome      String?      // 'positivo' | 'neutro' | 'negativo' | livre
  notes        String?      @db.Text
  attachments  Json?
  createdAt    DateTime     @default(now())

  salesUser    SalesUser    @relation(fields: [salesUserId], references: [id])

  @@index([salesUserId, createdAt(sort: Desc)])
  @@index([leadId])
  @@index([integradorId])
  @@index([opportunityId])
}

enum AssetType {
  SCRIPT     // script de call ou de WhatsApp
  DECK       // apresentação PDF/PPT
  VIDEO      // vídeo de pitch ou demo
  PDF        // material complementar
  TEMPLATE   // template de email/whatsapp
  CASE_STUDY // case de cliente
}

model SalesAsset {
  id          String      @id @default(uuid())
  title       String
  type        AssetType
  funnelStage String?     // 'NEW' | 'CONTACTED' | 'DEMO_SENT' | 'NEGOTIATION' | livre
  url         String?
  body        String?     @db.Text  // para SCRIPT/TEMPLATE
  description String?
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([type, active])
}

model LeadScore {
  leadId     String   @id
  score      Int      // 0-100
  reasonsJson Json    // [{factor: 'cnpj_size', points: 20, label: 'Empresa grande'}, ...]
  computedAt DateTime @default(now())
  @@index([score])
}

enum OpportunityType {
  NEW_LEAD     // novo prospect
  CROSS_SELL   // cliente existente, novo módulo
  UPSELL       // cliente existente, plano superior
  RENEWAL      // renovação contrato anual
}

enum OpportunityStatus {
  OPEN
  WON
  LOST
  STALLED
}

// SalesOpportunity — pode estar atrelada a um Lead (NEW_LEAD) ou a um
// Integrador (CROSS_SELL/UPSELL/RENEWAL). Detector automático cria
// oportunidades CROSS_SELL/UPSELL ao identificar sinais (vertical sem módulo,
// quota próxima do limite, etc).
model SalesOpportunity {
  id              String              @id @default(uuid())
  type            OpportunityType
  status          OpportunityStatus   @default(OPEN)
  leadId          String?             // se NEW_LEAD
  integradorId    String?             // se CROSS_SELL/UPSELL/RENEWAL
  ownerId         String?             // SalesUser.id
  title           String
  description     String?             @db.Text
  modulesProposed String[]            @default([])
  estimatedMrr    Float?              // R$ MRR estimado se fechar
  probability     Int?                // 0-100
  reasonAi        String?             @db.Text  // por que sistema sugeriu (auto-gen)
  closeDate       DateTime?           // prevista
  closedAt        DateTime?
  lostReason      String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  owner           SalesUser?          @relation(fields: [ownerId], references: [id])

  @@index([status, type])
  @@index([integradorId])
  @@index([leadId])
  @@index([ownerId])
}

// LeadAssignment — atribuição de lead a SDR/AE (round-robin ou manual).
model LeadAssignment {
  id          String    @id @default(uuid())
  leadId      String
  salesUserId String
  assignedAt  DateTime  @default(now())
  reason      String?   // 'round-robin' | 'manual' | 'expertise' | 'rebalance'
  active      Boolean   @default(true)

  @@index([leadId, active])
  @@index([salesUserId, active])
}

// LeadFollowUp — registro de atividade CRM associado a um Lead.
// Alimenta o timeline do painel unificado LeadsPage.
model LeadFollowUp {
  id          String       @id @default(uuid())
  leadId      String
  parentId    String?      // se preenchido, é uma resposta a outro follow-up (thread)
  type        FollowUpType @default(NOTE)
  content     String       @db.Text
  dueDate     DateTime?    // prazo/data do compromisso (para MEETING/TASK)
  completed   Boolean      @default(false)
  createdById String       // user que criou o registro (auditoria)

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  lead        Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  parent      LeadFollowUp? @relation("FollowUpReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies     LeadFollowUp[] @relation("FollowUpReplies")

  @@index([leadId, createdAt])
  @@index([parentId])
}

// =============================================================================
// LOTE 1 — Demo invite + Approval workflow
// =============================================================================

// DemoInvite — convite mágico enviado a um Lead para aprovar a conta dele.
//
// Fluxo:
//   1. Admin global aprova um lead → gera DemoInvite (token + expiresAt 14d)
//   2. Sistema envia email + WhatsApp com link `https://app.iacloud.com.br/demo/<token>`
//   3. Lead acessa o link → vê tela com plano sugerido + form para escolher
//      senha → POST /demo/<token>/accept dispara conversão
//   4. POST /leads/:id/convert (admin) cria Integrador OU ClienteFinal +
//      User admin do tenant + marca Lead.status=CONVERTED + DemoInvite.consumedAt
//
// D11: token reusável dentro da janela — se Lead acessa, fecha browser, e
// volta depois, mesmo token funciona. consumedAt só popula no aceite final.
enum DemoInviteStatus {
  PENDING // emitido, aguardando aceite
  ACCEPTED // lead aceitou, tenant criado
  EXPIRED // passou da janela
  REVOKED // admin revogou manualmente
}

model DemoInvite {
  id               String           @id @default(uuid())
  leadId           String
  // Token plaintext armazenado em hash (SHA-256). Plaintext só aparece UMA
  // vez no momento da emissão (`/leads/:id/invite` retorna o link completo).
  tokenHash        String           @unique
  status           DemoInviteStatus @default(PENDING)
  expiresAt        DateTime
  // Plano comercial sugerido na hora do convite (texto livre, igual ClienteFinal.commercialPlan).
  suggestedPlan    String?          @db.Text
  // Tipo final que será criado quando aceito: precisa bater com Lead.kind.
  // Permite override manual: lead veio CLIENTE_FINAL mas Admin decide criar
  // Integrador, por exemplo (raro, mas suportado).
  targetKind       LeadKind
  // ClienteFinal só quando targetKind=CLIENTE_FINAL: a qual integrador hospedar
  // (default: tenant "IACV Direct").
  hostIntegradorId String?
  consumedAt       DateTime?
  emailSent        Boolean          @default(false)
  emailSentAt      DateTime?
  whatsappSent     Boolean          @default(false)
  // Admin que emitiu — auditoria.
  createdByUserId  String
  notes            String?          @db.Text
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([status, expiresAt])
}

// ApprovalRequest — D14: ações sensíveis do Admin global (criar Integrador,
// deletar tenant, alterar billing) que precisam de OK do Super Admin.
//
// Genérico: action é string, payload é JSON. A rota que dispara a ação
// marca-se requested → outra rota /approvals/:id/approve aprova → backend
// relê payload e executa de fato.
enum ApprovalAction {
  CREATE_INTEGRADOR
  DELETE_INTEGRADOR
  CONVERT_LEAD
  DELETE_CLIENTE_FINAL
  DELETE_USER
  CHANGE_BILLING
  RESET_USER_PASSWORD
  PROVISION_EDGE_NODE  // Sprint R7: integrador solicitou licença, super admin aprova
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXECUTED // aprovado E ação foi executada
  EXPIRED // 7d sem resposta
}

model ApprovalRequest {
  id                String         @id @default(uuid())
  action            ApprovalAction
  status            ApprovalStatus @default(PENDING)
  // Quem solicitou (Admin global) — referência textual; user pode sumir mas
  // o registro continua. Auditoria preserva o id originalmente.
  requestedByUserId String
  // Payload da ação serializado: tudo que o handler precisa pra executar
  // após approve. Ex.: {leadId: "...", targetKind: "INTEGRADOR", ...}.
  payloadJson       Json
  // Resultado da execução: detalhes do que foi criado/alterado.
  resultJson        Json?
  reason            String?        @db.Text // motivo da solicitação
  rejectedReason    String?        @db.Text
  // Quem aprovou/rejeitou (SUPER_ADMIN).
  decidedByUserId   String?
  decidedAt         DateTime?
  executedAt        DateTime?
  expiresAt         DateTime
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([status, expiresAt])
  @@index([action, status])
  @@index([requestedByUserId])
}

// =============================================================================
// LOTE 3 — Acessos per-cliente para técnicos integradores
// =============================================================================

// IntegradorTechnicianAccess — ACL granular: quais clientes finais um técnico
// (role=INTEGRADOR_TECNICO) pode acessar dentro do seu integrador.
//
// Default sem registros = acesso a TODOS os clientes do integrador (compat
// com instalações antigas onde os técnicos viam tudo). Quando há ao menos
// uma linha pra um técnico, vira allowlist (deny-by-default).
//
// Scope textual permite expansão futura ('VIEWER', 'OPERATOR', 'FULL').
model IntegradorTechnicianAccess {
  id               String    @id @default(uuid())
  technicianUserId String
  integradorId     String
  clienteFinalId   String
  scope            String    @default("FULL") // 'VIEWER' | 'OPERATOR' | 'FULL'
  grantedByUserId  String
  grantedAt        DateTime  @default(now())
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  technician   User         @relation("TechnicianAccesses", fields: [technicianUserId], references: [id], onDelete: Cascade)
  integrador   Integrador   @relation(fields: [integradorId], references: [id], onDelete: Cascade)
  clienteFinal ClienteFinal @relation(fields: [clienteFinalId], references: [id], onDelete: Cascade)

  @@unique([technicianUserId, clienteFinalId])
  @@index([integradorId])
  @@index([clienteFinalId])
  @@index([technicianUserId])
}

// =============================================================================
// LOTE 4 — White-label (custom domains)
// =============================================================================

// CustomDomain — domínio externo (ex.: "monitor.acmecorp.com.br") que o
// cliente aponta via CNAME pra `app.iacloud.com.br`. O Worker resolve o host,
// carrega a branding configurada e injeta X-ICV-Tenant.
//
// verified: TXT challenge valida que o cliente realmente controla o domínio
// antes de servir conteúdo (anti-takeover). Só após verified=true o domínio
// fica ativo.
//
// targetType: pode apontar pra um Integrador (whitelabel da operação inteira)
// OU pra um único ClienteFinal (vanity URL pro portal de um cliente). Não
// pode os dois ao mesmo tempo — DB CHECK garante (ver migração).
enum CustomDomainStatus {
  PENDING_DNS // criado, aguardando CNAME apontar
  PENDING_VERIFICATION // CNAME OK, aguardando TXT challenge
  ACTIVE // ambos OK, servindo
  ERROR // CNAME quebrou ou TXT removido
  DISABLED // operador pausou
}

model CustomDomain {
  id             String             @id @default(uuid())
  hostname       String             @unique // ex.: "monitor.acmecorp.com.br"
  status         CustomDomainStatus @default(PENDING_DNS)
  // Apenas 1 destes preenchido (DB CHECK opcional via SQL raw na migração)
  integradorId   String?
  clienteFinalId String?
  // Token TXT pra DNS challenge: cliente cria
  //   _icv-verify.monitor.acmecorp.com.br TXT "<verifyToken>"
  // Backend valida via dns.resolveTxt() antes de marcar ACTIVE.
  verifyToken    String             @unique
  verifiedAt     DateTime?
  lastCheckedAt  DateTime?
  lastError      String?            @db.Text
  // Cloudflare Saas-style hostname registration (futuro). Quando integrarmos
  // SSL pra Saas, guardamos o ID retornado pela API CF.
  cfHostnameId   String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  integrador   Integrador?   @relation(fields: [integradorId], references: [id], onDelete: Cascade)
  clienteFinal ClienteFinal? @relation(fields: [clienteFinalId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([integradorId])
  @@index([clienteFinalId])
}

// =============================================================================
// LOTE 5 — Impersonation (suporte/debug com auditoria forte)
// =============================================================================

// ImpersonationSession — Super Admin assume identidade de outro user (SUPER
// só, NÃO Admin global) para debug. Banner permanente na UI; toda ação
// efetuada na sessão fica linkada via AuditLog.metadataJson.impersonatedBy.
//
// Ticket: gerado plaintext no POST /auth/impersonate; cliente troca por JWT
// de curta duração (max 1h, configurável). reason obrigatório — sem ele,
// registro não é criado.
model ImpersonationSession {
  id           String    @id @default(uuid())
  superAdminId String // user.id do SUPER_ADMIN que iniciou
  targetUserId String
  reason       String    @db.Text
  // JWT emitido (hash do plaintext, p/ revogação) — opcional, cobre caso
  // do super admin querer matar uma sessão antes de expirar.
  jwtJti       String?   @unique
  startedAt    DateTime  @default(now())
  endedAt      DateTime?
  endedReason  String? // 'manual' | 'expired' | 'revoked'
  ipAddress    String?
  userAgent    String?   @db.Text

  target User @relation("ImpersonationTarget", fields: [targetUserId], references: [id])

  @@index([superAdminId, startedAt])
  @@index([targetUserId, startedAt])
}

// =============================================================================
// NOTIFICAÇÕES — Canal WhatsApp via Evolution API (tenant-scoped)
// =============================================================================

// NotificationChannel — canal WhatsApp via Evolution API.
// 1 instância por ClienteFinal — provisionada automaticamente pelo painel.
// connectionState segue estados Evolution: open | connecting | close
model NotificationChannel {
  id             String @id @default(uuid())
  clienteFinalId String @unique // 1 canal por cliente final
  provider       String @default("evolution")

  // Evolution API instance
  instanceName    String  @unique // ex.: "icv-shopping-abc12345"
  instanceId      String? // ID interno retornado pela Evolution
  connectionState String  @default("close") // open | connecting | close

  // WhatsApp conectado
  phoneNumber String? // E.164 sem + (ex.: 5511999999999)
  profileName String?

  // QR Code / Pairing
  pairingCode   String?
  qrCodePayload String?   @db.Text // base64 data URL ou string raw
  lastQrAt      DateTime?

  // Timestamps de controle
  lastConnectedAt    DateTime?
  lastDisconnectedAt DateTime?
  lastSyncAt         DateTime?
  lastError          String?   @db.Text

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Destinatários de alertas automáticos (lista de telefones E.164 sem +)
  recipients String[] @default([])

  clienteFinal ClienteFinal @relation(fields: [clienteFinalId], references: [id], onDelete: Cascade)

  @@index([connectionState])
}

/// Instância WhatsApp do FABRICANTE (singleton). Recebe alertas comerciais
/// (leads novos, demos, aprovações) e do sistema (P0/P1) destinados ao
/// SUPER_ADMIN. Mesma estrutura do NotificationChannel, mas sem FK para
/// ClienteFinal — o singleton é identificado por id fixo "system".
model SystemNotificationChannel {
  id              String  @id @default("system") // singleton — sempre "system"
  provider        String  @default("evolution")

  instanceName    String  @unique
  instanceId      String?
  connectionState String  @default("close")

  phoneNumber String?
  profileName String?

  pairingCode   String?
  qrCodePayload String?   @db.Text
  lastQrAt      DateTime?

  lastConnectedAt    DateTime?
  lastDisconnectedAt DateTime?
  lastSyncAt         DateTime?
  lastError          String?   @db.Text

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recipients String[] @default([])

  @@index([connectionState])
}

// NotificationLog — histórico de mensagens enviadas pelo canal WhatsApp.
// Registra toda mensagem (teste manual + alertas automáticos).
model NotificationLog {
  id             String   @id @default(uuid())
  clienteFinalId String
  instanceName   String   // cópia denormalizada para histórico mesmo após troca de instância
  toPhone        String   // E.164 sem + (ex.: 5511999999999)
  message        String   @db.Text
  status         String   @default("sent") // sent | failed | delivered
  errorMessage   String?  @db.Text
  evolutionMsgId String?  // ID retornado pela Evolution API
  origin         String   @default("manual") // manual | alert | bulk
  sentAt         DateTime @default(now())

  clienteFinal ClienteFinal @relation("ClienteNotificationLogs", fields: [clienteFinalId], references: [id], onDelete: Cascade)

  @@index([clienteFinalId, sentAt(sort: Desc)])
  @@index([status])
  @@index([toPhone])
}

// ── Configuração de sistema (key/value genérico) ──────────────────────────
model SystemConfig {
  key       String   @id
  value     String   @db.Text // JSON string ou plain string
  updatedAt DateTime @updatedAt
}

// =============================================================================
// ALERTAS POR E-MAIL — Multi-tenant, escalada, dedup, digest
// =============================================================================

/// Destinatário de alertas — um por row, por tenant (ClienteFinal OU Integrador)
model AlertRecipient {
  id             String  @id @default(uuid())
  email          String
  name           String? // "NOC Turno A", "João Segurança"

  // Escopo — exatamente um dos dois preenchido
  clienteFinalId String?
  integradorId   String?

  active         Boolean @default(true)

  // ── Severidades aceitas ────────────────────────────────────────────────────
  rcvCritical    Boolean @default(true)
  rcvWarning     Boolean @default(true)
  rcvInfo        Boolean @default(false)

  // ── Tipos de evento aceitos ────────────────────────────────────────────────
  rcvCameraDown  Boolean @default(true)   // câmera offline / ERROR
  rcvCameraUp    Boolean @default(false)  // câmera voltou (recovery)
  rcvTriggerFire Boolean @default(true)   // trigger semântico disparou
  rcvDigest      Boolean @default(false)  // resumo diário

  // ── Escalada para Integrador ───────────────────────────────────────────────
  // Válido apenas em destinatários de ClienteFinal.
  // Quando true e o alerta for CRITICAL, o Integrador deste CF é copiado.
  escalateToIntegrador Boolean @default(false)

  // ── Janela silenciosa (sem envios nesse período) ──────────────────────────
  // Formato HH:MM (horário local do timezone do ClienteFinal ou "America/Sao_Paulo")
  quietStart     String? // ex: "22:00"
  quietEnd       String? // ex: "07:00"

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  clienteFinal   ClienteFinal? @relation(fields: [clienteFinalId], references: [id], onDelete: Cascade)
  integrador     Integrador?   @relation(fields: [integradorId],   references: [id], onDelete: Cascade)

  @@unique([email, clienteFinalId])
  @@unique([email, integradorId])
  @@index([clienteFinalId, active])
  @@index([integradorId,   active])
}

/// Log de entrega de cada e-mail de alerta (rastreamento + dedup/cooldown)
model AlertDelivery {
  id             String   @id @default(uuid())

  // Chave de deduplicação (ex: "camera_down:cam-uuid", "trigger:trig-uuid")
  alertKey       String

  recipientEmail String
  subject        String
  // SENT | FAILED | SUPPRESSED_COOLDOWN | SUPPRESSED_QUIET | SUPPRESSED_LIMIT
  status         String

  errorMsg       String?  @db.Text

  // Contexto do evento
  // CAMERA_DOWN | CAMERA_UP | TRIGGER_FIRE | DIGEST
  eventType      String
  // INFO | WARNING | CRITICAL
  severity       String

  cameraId       String?
  clienteFinalId String?
  integradorId   String?
  metadataJson   Json?    // payload completo do evento (para auditoria / reenvio)

  sentAt         DateTime @default(now())

  // Próximo envio permitido para esta (alertKey + recipientEmail).
  // Se now() < suppressUntil → status = SUPPRESSED_COOLDOWN.
  suppressUntil  DateTime?

  @@index([alertKey, recipientEmail])
  @@index([clienteFinalId, sentAt])
  @@index([cameraId, sentAt])
}

/// Configuração global de alertas por ClienteFinal
model AlertConfig {
  id             String  @id @default(uuid())
  clienteFinalId String  @unique

  // Cooldowns em segundos (evita spam para o mesmo evento)
  cooldownCameraDown  Int @default(3600)  // 1h — câmera offline (mesmo ID)
  cooldownTrigger     Int @default(300)   // 5min — trigger recorrente
  cooldownCameraUp    Int @default(600)   // 10min — recovery

  // Grace period: espera N segundos antes de enviar alerta de câmera offline
  // (evita falsos positivos de restart breve de go2rtc / câmera)
  offlineGraceSec     Int @default(120)   // 2 minutos

  // Limites anti-spam globais (por ClienteFinal, todos os destinatários)
  maxEmailsPerHour    Int @default(20)
  maxEmailsPerDay     Int @default(100)

  // Digest diário
  digestEnabled       Boolean @default(false)
  digestTime          String  @default("08:00") // HH:MM
  digestTimezone      String  @default("America/Sao_Paulo")

  // O Integrador pode forçar recebimento de CRITICAL mesmo sem escalada
  // configurada pelos usuários do ClienteFinal
  integradorForceReceiveCritical Boolean @default(false)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  clienteFinal   ClienteFinal @relation(fields: [clienteFinalId], references: [id], onDelete: Cascade)
}

// =============================================================================
// STORAGE MANAGEMENT — Multi-tenant bucket tracking (Sprint Storage.1)
// =============================================================================

enum StorageType {
  R2        // Cloudflare R2 gerenciado pelo sistema
  CUSTOM_S3 // S3-compatible fornecido pelo integrador
}

/// Bucket de storage associado a um Integrador.
/// Centraliza config + métricas que antes ficavam espalhadas no Integrador.
model StorageBucket {
  id             String      @id @default(uuid())
  integradorId   String
  type           StorageType @default(R2)
  name           String                          // ex: icv-{integradorId}
  endpoint       String?                         // null para R2 (usa env)
  region         String?
  accessKeyEnc   String?                         // encrypted
  secretKeyEnc   String?                         // encrypted
  retainDays     Int         @default(30)
  totalBytes     BigInt      @default(0)         // atualizado por cron
  objectCount    Int         @default(0)
  lastSyncAt     DateTime?
  active         Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  integrador     Integrador     @relation(fields: [integradorId], references: [id], onDelete: Cascade)
  usageRecords   StorageUsage[]

  @@unique([integradorId, type])
  @@index([integradorId])
}

/// Consumo de storage por Cliente Final / Câmera.
/// Permite breakdown de uso para billing e dashboard.
model StorageUsage {
  id             String    @id @default(uuid())
  bucketId       String
  clienteFinalId String?   // null = uso geral do integrador
  cameraId       String?   // null = agregado do cliente
  usedBytes      BigInt    @default(0)
  objectCount    Int       @default(0)
  recordedAt     DateTime  @default(now())

  bucket         StorageBucket @relation(fields: [bucketId], references: [id], onDelete: Cascade)
  clienteFinal   ClienteFinal? @relation(fields: [clienteFinalId], references: [id], onDelete: SetNull)
  camera         Camera?       @relation(fields: [cameraId], references: [id], onDelete: SetNull)

  @@index([bucketId, recordedAt])
  @@index([clienteFinalId])
  @@index([cameraId])
}

// =============================================================================
// STORAGE ACCESS LOG — Auditoria de acesso ao storage multi-tenant
// =============================================================================

enum StorageAccessAction {
  VIEW_DASHBOARD    // Visualização do dashboard de storage
  VIEW_BUCKET       // Visualização detalhada de bucket
  VIEW_CLIENTE      // Visualização de storage de cliente final
  BROWSE_OBJECTS    // Navegação no browser de objetos
  PREVIEW_OBJECT    // Preview de arquivo (imagem/vídeo)
  DOWNLOAD_OBJECT   // Download de arquivo
  DELETE_OBJECT     // Exclusão de arquivo individual
  DELETE_ORPHANS    // Exclusão de gravações órfãs (batch)
  UPDATE_CONFIG     // Atualização de configuração de storage
  UPDATE_LIFECYCLE  // Atualização de regras de lifecycle
}

/// Log de acesso ao storage para auditoria e compliance.
/// Respeita multi-tenancy: cada nível só vê seus logs.
model StorageAccessLog {
  id             String              @id @default(uuid())

  // Ator — quem executou a ação
  actorType      String              // SUPER_ADMIN | INTEGRADOR | USER
  actorId        String              // ID do ator
  actorEmail     String?             // Email para referência rápida

  // Contexto multi-tenant
  integradorId   String?
  clienteFinalId String?

  // Ação executada
  action         StorageAccessAction

  // Recursos acessados
  bucketName     String?
  objectKey      String?             // Caminho do objeto (se aplicável)
  cameraId       String?             // Se ação relacionada a câmera específica

  // Detalhes da ação
  objectCount    Int?                // Quantidade de objetos afetados
  bytesAffected  BigInt?             // Bytes afetados (downloads, exclusões)
  metadata       Json?               // Dados adicionais (filtros usados, etc)

  // Request info
  ipAddress      String?
  userAgent      String?

  // Resultado
  success        Boolean             @default(true)
  errorMessage   String?

  createdAt      DateTime            @default(now())

  // Relações opcionais para queries
  integrador     Integrador?         @relation("StorageAccessLogs", fields: [integradorId], references: [id], onDelete: SetNull)
  clienteFinal   ClienteFinal?       @relation("StorageAccessLogs", fields: [clienteFinalId], references: [id], onDelete: SetNull)

  @@index([integradorId, createdAt])
  @@index([clienteFinalId, createdAt])
  @@index([action, createdAt])
  @@index([actorId, createdAt])
  @@index([cameraId, createdAt])
}

// ═════════════════════════════════════════════════════════════════════════════
// PRICING CMS — Fase 1 do plano docs/13-PLAN-WHITELABEL-PRICING.md
// SUPER_ADMIN edita planos sem deploy. Frontend /pricing consome via API.
// IntegradorPlan + PlanSubscription serão adicionados em Fase 3 (multi-tenant).
// ═════════════════════════════════════════════════════════════════════════════

/// Planos PRO (cards principais da /pricing) — gerenciado pelo SUPER_ADMIN
model PlatformPlan {
  id              String   @id @default(uuid())
  /// "starter" "growth" "scale" "enterprise" — identificador estável.
  /// Não é mais @unique sozinho — composto com tenantId pra permitir overrides
  /// por integrador (mesmo slug do master, mas tenantId preenchido).
  slug            String
  name            String
  tagline         String

  /// null = "Sob consulta" (CTA: consultant)
  priceMonthly    Decimal? @db.Decimal(10, 2)
  /// Comparativo Monuv (mostra economia). null = sem comparação
  priceMonuv      Decimal? @db.Decimal(10, 2)

  // ── Multi-tenant white-label (Sprint D — 2026-05-06) ────────────────────
  /// null = plano master (do fabricante); uuid = override de um integrador.
  /// Quando preenchido, este plano só aparece para o tenant correspondente.
  tenantId        String?
  /// True quando é um override criado pelo integrador a partir do master.
  /// O master de mesmo slug é a referência para campos não preenchidos aqui.
  isOverride      Boolean  @default(false)
  /// Custo de atacado: o que o integrador paga AO FABRICANTE pelo plano.
  /// Define o piso de `priceMonthly` em qualquer override (validação server).
  /// Só preenchido em planos master (tenantId=null). null = sem floor.
  wholesalePriceMonthly Decimal? @db.Decimal(10, 2)

  /// "22" para fixo, "∞" ou "ilimitado" para Enterprise
  connections     String
  retention       String   // "7 dias", "30+ dias"
  totalAIs        String   // "22 IAs", "Tudo + Edge + Federação"

  ctaLabel        String   // "Contratar agora", "Falar com consultor"
  ctaKind         String   // "self-service" | "consultant"
  ctaUrl          String?  // override pro CTA (ex: WhatsApp, /signup?plan=X)

  /// Bullets list — array preservando ordem
  highlights      String[]

  recommended     Boolean  @default(false)
  accent          String   @default("cyan")  // "cyan" "violet" "emerald" "amber"

  // Caps técnicos (enforcement na criação de tenant — Fase 3+)
  maxCameras      Int?
  retentionDays   Int?
  modulesIncluded AnalyticsModel[]
  edgeBoxScenario String?  // "A" | "B" | "C"

  // Exibição
  displayOrder    Int      @default(0)
  publicVisible   Boolean  @default(true)
  archived        Boolean  @default(false)

  // Audit
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  updatedBy       String?

  @@unique([tenantId, slug])
  @@index([displayOrder])
  @@index([archived, publicVisible])
  @@index([tenantId])
}

/// IAs Avulsas — câmera contrata módulo individual (R$/câmera/mês)
model AIAddonPlan {
  id              String   @id @default(uuid())
  slug            String   @unique  // "movement" "presence" "lpr" "ppe" "demographics"
  name            String

  /// Chave do ícone Lucide React (Activity, Users, Car, ShieldCheck, Camera, etc.)
  iconKey         String

  priceIACV       Decimal? @db.Decimal(10, 2)
  priceMonuv      Decimal? @db.Decimal(10, 2)
  /// true = não tem equivalente Monuv (PPE, Demographics, Semantic)
  exclusive       Boolean  @default(false)

  /// Tailwind class (ex: "text-violet-400")
  color           String   @default("text-cyan-400")
  description     String?  @db.Text

  /// Mapeia para AnalyticsModel quando aplicado a uma câmera
  analyticsModel  AnalyticsModel?

  displayOrder    Int      @default(0)
  publicVisible   Boolean  @default(true)
  archived        Boolean  @default(false)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  updatedBy       String?

  @@index([displayOrder])
  @@index([archived, publicVisible])
}

/// Matriz VMS Storage (resolução × dias retenção)
model VMSStoragePrice {
  id           String   @id @default(uuid())
  resolution   String   // "VGA" "HD" "Full HD" "4K"
  days         Int      // 0 1 3 7 15 30 60 90 180
  priceIACV    Decimal  @db.Decimal(10, 2)
  priceMonuv   Decimal? @db.Decimal(10, 2)

  active       Boolean  @default(true)
  updatedAt    DateTime @updatedAt
  updatedBy    String?

  @@unique([resolution, days])
  @@index([resolution])
}

/// Textos do hero da /pricing — singleton (1 row)
model PricingHero {
  id                 String  @id @default(uuid())

  /// "Preços transparentes — self-service — cancele quando quiser"
  tagline            String
  /// "Preços que competem e features que superam"
  headline           String
  /// JSON: [{word:"competem", color:"cyan"}, {word:"superam", color:"violet"}]
  headlineHighlights Json?
  /// Parágrafo abaixo do título
  subtitle           String  @db.Text

  ctaLoginText       String  @default("Entrar")
  ctaLoginUrl        String  @default("/login")
  ctaConsultantText  String  @default("Falar com consultor")
  ctaConsultantUrl   String?

  active             Boolean @default(true)
  updatedAt          DateTime @updatedAt
  updatedBy          String?
}

/// Cards comparativos "vs concorrentes" no rodapé
model CompetitorComparison {
  id            String  @id @default(uuid())
  iconKey       String  // "Zap", "Clock", "Cpu", "Search", "Globe"
  label         String  // "LATÊNCIA AO VIVO"
  ourValue      String  // "<1s (WHEP)"
  ourValueColor String  @default("text-cyan-400")
  theirValue    String? // "8-20s (HLS)"
  description   String?

  displayOrder  Int     @default(0)
  active        Boolean @default(true)
  updatedAt     DateTime @updatedAt
  updatedBy     String?

  @@index([displayOrder, active])
}

/// Settings globais da /pricing (singleton, 1 row)
model PricingSettings {
  id                    String  @id @default(uuid())
  showAnnualToggle      Boolean @default(true)
  annualDiscountPct     Int     @default(20)
  showTabPlans          Boolean @default(true)
  showTabAIs            Boolean @default(true)
  showTabVMS            Boolean @default(true)
  showCompetitorSection Boolean @default(true)

  defaultCurrency       String  @default("BRL")

  updatedAt             DateTime @updatedAt
  updatedBy             String?
}
