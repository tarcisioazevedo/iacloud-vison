// =============================================================================
// MÓDULOS — Permissões de funcionalidades por nível de tenant
// =============================================================================

/// Módulos de Analytics liberados pelo SuperAdmin para cada Integrador
model IntegradorModule {
  id           String         @id @default(uuid())
  integradorId String
  module       AnalyticsModel
  enabled      Boolean        @default(true)
  grantedAt    DateTime       @default(now())
  grantedBy    String? // SuperAdmin id que concedeu

  integrador Integrador @relation(fields: [integradorId], references: [id], onDelete: Cascade)

  @@unique([integradorId, module])
  @@index([integradorId])
}

/// Módulos de Analytics liberados pelo Integrador para cada ClienteFinal
/// Só pode conceder módulos que o próprio Integrador possui
model ClienteFinalModule {
  id             String         @id @default(uuid())
  clienteFinalId String
  module         AnalyticsModel
