enum FfmpegHwAccel {
  NONE
  VAAPI
  NVIDIA_NVDEC
  INTEL_QSV_H264
  INTEL_QSV_H265
  RPI_V4L2_H264
  RPI_V4L2_H265
  ROCKCHIP_RKMPP
  AMD_ROCM
}

enum DetectorType {
  CPU
  CORAL_USB
  CORAL_PCI
  OPENVINO_CPU
  OPENVINO_GPU
  TENSORRT
  ONNX
  HAILO8
  HAILO8L
  RKNN
  ROCM
  VERTEX_AI // Inferência na nuvem via Vertex AI
}

enum RecordingMode {
  ALL // 24/7
  MOTION // apenas com movimento
  ACTIVE_OBJECTS // apenas enquanto há objetos rastreados
  DISABLED
}

// Modo de ingestão da câmera (Camera.ingestMode):
//   RTSP_PULL — backend puxa o RTSP da câmera (rede local OU edge OU
//               port-forward). Sub-segundo de latência. Default histórico.
//   RTMP_PUSH — câmera empurra RTMP pro VSaaS (atravessa NAT outbound,
//               não precisa hardware nem rede local). 2-5s de latência.
//               Compatível com Hikvision/Dahua/Axis/Intelbras ~2018+.
enum IngestMode {
  RTSP_PULL
  RTMP_PUSH
}

// SRT publish policy por câmera (Box → MediaMTX Cloud).
// Cloud retorna esse modo via /iacv-box/srt-config; Box configura go2rtc em conformidade.
enum CameraPublishMode {
  AUTO        // Cloud decide com base em #cams da Box (8 cams=ALWAYS, 36+=ON_DEMAND)
  ALWAYS      // Box sempre publica SRT (instant play, mais bandwidth uplink)
  ON_DEMAND   // Box publica só quando alguém pede (economia uplink, +1s TTFF)
  SUB_ONLY    // Box publica APENAS substream sempre, mainstream nunca
}

// Evento de auditoria do pipeline RTMP push (IngestLog.event):
enum IngestEvent {
  PUBLISH_START // câmera começou a empurrar (key válida)
  PUBLISH_END // câmera fechou conexão (limpa)
  AUTH_OK // key validada e vinculada à câmera
  AUTH_FAIL // key não bate com nenhuma câmera (push rejeitado)
  UNKNOWN_PATH // path RTMP fora do padrão `live/<key>`
  ERROR // erro inesperado no go2rtc/proxy
}

enum EdgeNodeStatus {
  ONLINE
  OFFLINE
  DEGRADED
  MAINTENANCE
  PROVISIONING
  PENDING_APPROVAL  // Sprint R7: integrador solicitou, aguarda super admin
  SUSPENDED         // Sprint R7: super admin suspendeu licença remotamente
}

enum CameraStatus {
  ACTIVE
  INACTIVE
  ERROR
  MAINTENANCE
  PENDING_CONFIG
}

enum LiveMode {
  AUTO // WHEP primeiro, cai para MJPEG se falhar
  WHEP_ONLY // só WebRTC
  MJPEG_ONLY // só MJPEG (câmeras antigas, redes corporativas)
  DISABLED // desabilitado (live off)
}

enum CameraDeploymentMode {
  EDGE_BOX     // gerenciada por edge box local (recomendado)
  CLOUD_DIRECT // avulsa: ONVIF/RTSP/RTMP/P2P direto na cloud
}

enum EventSeverity {
  INFO
  WARNING
  CRITICAL
}

enum BillingCycle {
  MONTHLY
  ANNUAL
}

/// Tier comercial de white-label do integrador.
/// NONE       = usa marca IA Cloud Vision (sem white-label)
/// BASIC      = só logo + cores
/// PRO        = + domínio próprio + pricing override + email custom
/// ENTERPRISE = PRO + cliente final pode customizar (cascade Modelo D)
/// Defaults de capabilities resolvidos em src/services/whitelabel.service.ts —
/// tier é o "bucket"; capabilities (JSON em Integrador) permite override granular.
enum WhitelabelTier {
  NONE
  BASIC
  PRO
  ENTERPRISE
}

enum QuotaBlockPolicy {
  HARD_BLOCK // Bloqueia novas chamadas ao atingir limite
  SOFT_WARN // Envia alerta mas não bloqueia
  AUTO_UPGRADE // Upgrade automático de tier
}

// =============================================================================
// CAMADA DE TENANT — SuperAdmin · Integrador · ClienteFinal
// =============================================================================

model SuperAdmin {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  auditLogs AuditLog[]
}

/// Revendedor / Integrador B2B
model Integrador {
  id                    String       @id @default(uuid())
  name                  String
  tradeName             String? // Nome fantasia
  cnpj                  String?      @unique
  email                 String       @unique
  passwordHash          String
  phone                 String?
  website               String?
  logoUrl               String?
  gcpProjectId          String? // GCP Project ID dedicado deste integrador
  gcpServiceAccountJson String? // SA JSON (encrypted in app layer)
  // Subdomínio Cloudflare provisionado pra este tenant (<slug>.iacloud.com.br).
  // null = não provisionado ainda. UNIQUE pra evitar colisão de DNS — o
  // service também valida via slugify(), mas o constraint protege contra
  // race conditions em provisões concorrentes.
  cfSubdomain           String?      @unique
  cfDnsRecordId         String? // ID do registro DNS na Cloudflare (pra delete idempotente)
  active                Boolean      @default(true)
  billingCycle          BillingCycle @default(MONTHLY)

  // ── White-label (Sprint D — 2026-05-06) ──────────────────────────────────
  /// Tier comercial. Determina capabilities default (ver whitelabel.service.ts).
  whitelabelTier         WhitelabelTier @default(NONE)
  /// Override granular sobre os defaults do tier.
  /// Shape: { branding, domain, pricing, email, clientCustomization } — todos bool.
  /// null = usa defaults puros do tier. SUPER_ADMIN edita via /admin/whitelabel/:id.
  whitelabelCapabilities Json?

  // Limite de EdgeNodes que este integrador pode ativar. null = ilimitado.
  maxEdgeNodes          Int?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  // ── Storage S3 (Hetzner/AWS/R2) ────────────────────────────────────────────
  // Credenciais próprias do integrador para armazenamento de gravações/eventos.
  // Encrypted em app layer. Se null, usa storage global do sistema.
  storageEndpoint       String?      // e.g., https://fsn1.your-objectstorage.com
  storageRegion         String?      // e.g., fsn1
  storageAccessKeyEnc   String?      // Access Key ID (encrypted)
  storageSecretKeyEnc   String?      // Secret Access Key (encrypted)
  storageBucket         String?      // Bucket name (auto-created if missing)
  storageRetainDays     Int          @default(30) // Retenção padrão em dias

  clienteFinais     ClienteFinal[]
  apiQuotas         ApiQuota[]
  apiUsageLogs      ApiUsageLog[]
  invoices          Invoice[]
  users             User[]             @relation("IntegradorUsers")
  auditLogs         AuditLog[]
  modulePermissions IntegradorModule[] // módulos liberados pelo SuperAdmin

  // Lote 3: ACLs per-cliente para técnicos deste integrador.
  technicianAccesses IntegradorTechnicianAccess[]

  // Lote 4: domínios customizados deste tenant (whitelabel).
  customDomains CustomDomain[]

  // Alertas por e-mail: destinatários do integrador (recebem escalada de CFs)
  alertRecipients AlertRecipient[]

  // Storage buckets (Sprint Storage.1)
  storageBuckets StorageBucket[]

  // Storage access logs para auditoria
  storageAccessLogs StorageAccessLog[] @relation("StorageAccessLogs")

  // Onda 8 (cockpit-premium): tema white-label do portal cliente do integrador.
  // Relação 1:1 opcional — quando null, o portal renderiza com defaults do app.
  theme             IntegradorTheme?

  @@index([gcpProjectId])
}

/// Tema white-label aplicado no portal cliente de um integrador (Onda 8).
/// Os campos cobrem 4 eixos: paleta, tipografia, densidade e radius.
/// Não substitui logoUrl/cfSubdomain (que ficam no Integrador) — apenas os
/// tokens visuais que viram CSS vars no portal.
model IntegradorTheme {
  id           String     @id @default(uuid())
  integradorId String     @unique
  integrador   Integrador @relation(fields: [integradorId], references: [id], onDelete: Cascade)

  // 8.1 — Paleta principal (hex sem alpha; aplicado via CSS vars)
  primaryColor String @default("#06b6d4") // cyan-500
  accentColor  String @default("#8b5cf6") // violet-500
  successColor String @default("#10b981") // emerald-500
  dangerColor  String @default("#f43f5e") // rose-500

  // 8.2 — Família tipográfica
  // Valores válidos: "inter" | "inter-tight" | "system"
  fontFamily String @default("inter")

  // 8.3 — Densidade
  // Valores válidos: "compact" | "normal" | "comfortable"
  density String @default("normal")

  // 8.4 — Border radius
  // Valores válidos: "soft" | "square"
  radius String @default("soft")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Cliente final B2B2B — Shopping, Loja, Escola, etc.
model ClienteFinal {
  id             String         @id @default(uuid())
  integradorId   String
  name           String
  tradeName      String?
  cnpj           String?
  email          String
  phone          String?
  address        String?
  city           String?
  state          String?
  country        String         @default("BR")
  vertical       MarketVertical
  logoUrl        String?
  active         Boolean        @default(true)
  timezone       String         @default("America/Sao_Paulo")
  notifyEmail    String? // e-mail para alertas
  // Plano comercial textual (livre): observado pelo integrador no cadastro do
  // cliente final. Não é enum nem mapeia preços — é texto descritivo do que
  // foi acordado contratualmente (ex.: "Pacote 50 câmeras + LPR + suporte 8x5").
  // Texto puro para flexibilidade comercial; a contagem real (cameras/módulos)
  // continua governada por ClienteFinalModule + Site.
  commercialPlan String?        @db.Text

  // ── Portal white-label (Sprint CF.4) ────────────────────────────────────
  // Slug curto e único usado no portal público: <slug>.iacloud.com.br/portal
  // ou /portal/:slug. Quando null, o cliente final ainda não tem portal.
  portalSlug     String? @unique
  // Cores do tema do portal (hex). Caem pra default do app quando null.
  primaryColor   String? // ex.: "#06b6d4"
  secondaryColor String? // ex.: "#8b5cf6"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  integrador        Integrador           @relation(fields: [integradorId], references: [id])
  sites             Site[]
  users             User[]
  auditLogs         AuditLog[]
  modulePermissions ClienteFinalModule[] // módulos liberados pelo Integrador
  licensePlates     LicensePlate[] // placas cadastradas (LPR)
  faceIdentities    FaceIdentity[] // identidades cadastradas (face library)
  portalTokens      PortalAccessToken[] // magic-links emitidos pelo integrador

  // Lote 3: técnicos com acesso explícito a este cliente final.
  technicianAccesses IntegradorTechnicianAccess[]

  // Lote 4: domínios customizados (vanity) apontando direto pra este cliente.
  customDomains CustomDomain[]

  // WhatsApp Evolution API — 1 instância por cliente final.
  notificationChannel NotificationChannel?
  notificationLogs    NotificationLog[]    @relation("ClienteNotificationLogs")

  // Lote 7: Telegram Bot próprio deste cliente final (multi-tenant isolado).
  // Cada cliente cria seu bot no @BotFather e configura no painel.
  // O integrador NÃO tem acesso ao token do cliente, e vice-versa.
  telegramBotToken String? // Token do @BotFather (encrypted in app layer)
  telegramChatIds  String[] @default([]) // Grupos/canais para alertas

  // Alertas por e-mail
  alertRecipients AlertRecipient[]
  alertConfig     AlertConfig?

  // Storage usage breakdown (Sprint Storage.1)
  storageUsage StorageUsage[]

  // Storage access logs para auditoria
  storageAccessLogs StorageAccessLog[] @relation("StorageAccessLogs")

  @@index([integradorId])
  @@index([vertical])
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String
  role         UserRole
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Lote 5: força troca de senha no próximo login (post-invite ou pós-reset).
  mustChangePassword Boolean @default(false)

  // Lote 6: foto de perfil (URL, opcional). Resolução recomendada: 256×256.
  // Storage real (S3/MinIO) fora do scope deste schema — guardamos só a URL.
  avatarUrl String?

  // Lote 7: Telegram chatId para notificações diretas via Bot.
  // Populado quando o user clica "Conectar Telegram" no painel.
  telegramChatId String?

  // Vínculo: ou é do Integrador OU do ClienteFinal
  integradorId   String?
  clienteFinalId String?

  // Acesso restrito a Sites específicos (CLIENTE_OPERADOR / CLIENTE_VIEWER).
  // Vazio = acesso a todos os Sites do ClienteFinal.
  // Preenchido pelo CLIENTE_ADMIN para isolar operadores por filial/turno.
  allowedSiteIds String[] @default([])

  integrador   Integrador?   @relation("IntegradorUsers", fields: [integradorId], references: [id])
  clienteFinal ClienteFinal? @relation(fields: [clienteFinalId], references: [id])
  auditLogs    AuditLog[]

  // Lote 3: técnico-integrador com acesso restrito a alguns clientes finais.
  technicianAccesses IntegradorTechnicianAccess[] @relation("TechnicianAccesses")

  // Lote 5: sessões de impersonação onde este user foi alvo (auditoria reversa).
  impersonationSessions ImpersonationSession[] @relation("ImpersonationTarget")

  @@index([integradorId])
  @@index([clienteFinalId])
}

// =============================================================================
// CAMADA FÍSICA — Site · EdgeNode · Camera
// =============================================================================

/// Unidade física (filial, loja, campus, bloco)
model Site {
  id             String   @id @default(uuid())
  clienteFinalId String
  name           String // "Loja Centro", "Bloco A", "Galpão 1"
  address        String?
  city           String?
  state          String?
  country        String   @default("BR")
  latitude       Float?
  longitude      Float?
  timezone       String   @default("America/Sao_Paulo")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  clienteFinal ClienteFinal @relation(fields: [clienteFinalId], references: [id])
  edgeNodes    EdgeNode[]
  cameras      Camera[]
  floorPlans   FloorPlan[]

  @@index([clienteFinalId])
}

/// Nó Edge físico (Raspberry Pi 5 Hailo-8L, Intel NUC, etc.)
model EdgeNode {
  id               String         @id @default(uuid())
  siteId           String
  serialNumber     String         @unique
  name             String
  description      String?
  model            String? // "Raspberry Pi 5", "Intel NUC 13 Pro"
  accelerator      String? // "Hailo-8L", "Intel iGPU", "NVIDIA Jetson", "none"
  ipLocal          String?
  macAddress       String?        @unique
  apiToken         String         @unique @default(uuid()) // token de autenticação do edge
  status           EdgeNodeStatus @default(PROVISIONING)
  lastHeartbeat    DateTime?
  firmwareVersion  String?
  yoloModelVersion String? // "yolov8n", "yolov8s", etc.

  // ── go2rtc embutido (streaming WebRTC/WHEP + MJPEG fallback) ──────────────
  go2rtcEndpoint   String? // ex: "http://192.168.0.10:1984" (LAN) ou tunelado
  go2rtcAuth       String? // basic auth / token interno (criptografado)
  webrtcPublicHost String? // hostname público se o edge está atrás de NAT+port-fwd

  // Telemetria atual (snapshot do último heartbeat)
  cpuUsage      Float?
  memUsage      Float?
  diskUsage     Float?
  tempCelsius   Float?
  uptimeSeconds Int?
  fpsCurrent    Float?    // frames/s processados pelo modelo local
  networkInBps  Float?    // banda de entrada em bytes/s
  networkOutBps Float?    // banda de saída em bytes/s

  // ── Licença & configuração remota ─────────────────────────────────────────
  // licenseExpiresAt: quando a licença deste edge expira (null = sem prazo).
  //   Preenchido pelo integrador no cadastro ou via /api/integration/identity.
  licenseExpiresAt DateTime?

  // maxCameras: limite de câmeras licenciadas neste edge (null = ilimitado).
  maxCameras Int?

  // configRevision: contador de versão da config remota.
  //   Incrementado pelo painel ao salvar uma nova config para a Box.
  //   A Box compara com o valor local no heartbeat e faz pull quando diverge.
  //   Começa em 1 — Box que nunca recebeu config remota compara 1 == 1, sem pull.
  configRevision Int @default(1)

  // lastActivatedAt: quando a Box enviou o último POST /iacv-box/activate com sucesso.
  lastActivatedAt DateTime?

  // licenseKeyEnc: chave de licença cifrada com ICV_ENCRYPTION_KEY (AES-256-GCM).
  // Permite que INTEGRADOR_ADMIN recupere/visualize a chave sem armazenar plain-text.
  // Zerado quando rotate-token é chamado e uma nova chave é emitida.
  licenseKeyEnc  String?

  // technicianEmail: e-mail do técnico de campo que recebeu a chave por e-mail.
  technicianEmail String?

  // integradorId: desnormalização de Site→ClienteFinal→integradorId.
  // Preenchido no activate. Permite SSO: Box sabe qual integrador aceitar sem query extra.
  integradorId String?

  @@index([integradorId])

  // ── S0: Telemetria enriquecida & Vault ───────────────────────────────────
  // lastTelemetryRaw: snapshot completo do último heartbeat enriquecido (system, frigate, cameras, storage, network).
  //   Armazenado como JSON coluna — painel pode renderizar gauges e sparklines sem normalizar.
  lastTelemetryRaw  Json?

  // hardwareInventory: inventário de hardware enviado via POST /iacv-box/hardware-inventory (boot-time).
  //   Campos: cpu.model, cpu.cores, memoryGB, gpu.vendor, gpu.model, diskGB, networkInterfaces, detectedAt.
  hardwareInventory Json?

  // ── FCB-003/004 Sprint 0 wiring 2026-05-06 ──────────────────────────────
  // capabilitiesRevision: SHA1 12-char dos handlers (de /box/api/cmd/list).
  //   Box envia no heartbeat. Cloud compara com valor persistido — se mudou,
  //   refresca cache do painel admin (dropdown de comandos suportados).
  capabilitiesRevision String?
  lastCapabilitiesAt   DateTime?

  // brandingRevision: SHA1 do bloco branding (logo+paleta+nomes).
  //   Cloud usa pra detectar quando white-label foi alterado e disparar
  //   EdgeCommand REFRESH_BRANDING (ou Box puxa /api/branding no próximo poll).
  brandingRevision     String?
  lastBrandingChangeAt DateTime?

  // vaultBucket / vaultPrefix: identificação do bucket Cloudflare R2 deste node.
  //   Usados para gerar presigned URLs de clipes e snapshots sem expor credenciais mestre.
  vaultBucket     String?
  vaultPrefix     String?
  // vaultTokenId: ID do token R2 escopado deste EdgeNode (para revogação).
  vaultTokenId    String?
  // vaultExpiresAt: quando as credenciais R2 escopadas expiram.
  vaultExpiresAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  site           Site                @relation(fields: [siteId], references: [id])
  cameras        Camera[]
  heartbeats     EdgeHeartbeat[]
  commands       EdgeCommand[]
  apiUsageLogs   ApiUsageLog[]
  connectionLogs EdgeConnectionLog[]

  @@index([siteId])
  @@index([status])
  // Composite UNIQUE referenciado pelo composite FK em Camera(siteId,
  // edgeNodeId) → EdgeNode(siteId, id). Garante invariante: câmera só
  // pode apontar para edge no MESMO site (e portanto mesmo tenant).
  @@unique([siteId, id], name: "EdgeNode_siteId_id_key")
}

/// Comando enfileirado pela Cloud para ser drenado no próximo heartbeat da Box
model EdgeCommand {
  id          String   @id @default(uuid())
  edgeNodeId  String

  /// RESTART_CAMERA | RELOAD_MODEL | FORCE_RESYNC | UPDATE_ZONES
  type        String

  /// Payload específico do tipo (cameraId, modelName, zones, etc.)
  payload     Json     @default("{}")

  /// Quem criou o comando (admin ou sistema)
  createdById String?

  /// Quando a Cloud enfileirou
  issuedAt    DateTime @default(now())

  /// null = pendente; preenchido quando a Box confirma no heartbeat
  ackedAt     DateTime?

  /// ACK enriquecido (Box bridge be9c457, item 1.13 docs/08).
  /// Preenchidos quando Box envia ACK em POST /iacv-box/commands/:id/ack
  /// junto com {licenseKey, status, durationSec, errorMessage?, info?}.
  ackStatus       String?   /// "OK" | "ERROR" | "UNSUPPORTED"
  ackDurationSec  Float?
  ackErrorMessage String?
  ackInfo         Json?     /// Resultado estruturado do handler (ex: snapshot b64, diagnose)

  /// S0: quando o comando expira — Box não executa após este momento.
  /// null = sem expiração. Cloud pode setar 5min para comandos críticos.
  expiresAt   DateTime?

  edgeNode EdgeNode @relation(fields: [edgeNodeId], references: [id], onDelete: Cascade)

  @@index([edgeNodeId, ackedAt])
}

/// Pulsação do nó Edge a cada N segundos
model EdgeHeartbeat {
  id            String   @id @default(uuid())
  edgeNodeId    String
  cpuUsage      Float
  memUsage      Float
  diskUsage     Float
  tempCelsius   Float?
  networkInBps  Float?
  networkOutBps Float?
  fpsCurrent    Float? // frames/s processados localmente
  apiCallsSent  Int? // chamadas enviadas ao backend neste intervalo
  framesSkipped Int? // frames ignorados (sem contexto humano)
  recordedAt    DateTime @default(now())

  edgeNode EdgeNode @relation(fields: [edgeNodeId], references: [id])

  @@index([edgeNodeId, recordedAt])
}

/// Log de conexão/eventos do Edge Node — central de diagnóstico para suporte
model EdgeConnectionLog {
  id           String   @id @default(uuid())
  edgeNodeId   String

  /// ACTIVATE | HEARTBEAT | TUNNEL_PROVISION | TUNNEL_CONNECT | CONFIG_PULL | CAMERAS_SYNC | COMMAND_ACK
  eventType    String

  /// SUCCESS | FAILED | PENDING
  status       String

  /// IP de origem da requisição
  ipAddress    String?

  /// User-Agent do cliente (cloudflared, IACV-Box-Agent, etc.)
  userAgent    String?

  /// Código de erro (LICENSE_INVALID, TUNNEL_PROVISION_FAILED, etc.)
  errorCode    String?

  /// Mensagem de erro detalhada
  errorMessage String?

  /// Snapshot do request/response (sem dados sensíveis como tokens)
  payload      Json?

  /// Duração da operação em ms (latência)
  durationMs   Int?

  createdAt    DateTime @default(now())

  edgeNode EdgeNode @relation(fields: [edgeNodeId], references: [id], onDelete: Cascade)

  @@index([edgeNodeId, createdAt])
  @@index([eventType, status])
  @@index([createdAt])
}

/// Câmera IP individual — inspirada em Frigate NVR + Vertex AI Vision
model Camera {
  id          String  @id @default(uuid())
  siteId      String
  edgeNodeId  String?
  name        String // "Entrada Principal", "Praça de Alimentação"
  description String?
  location    String? // descrição livre do ponto físico
  zipCode     String? // CEP (ex: 01310-100)
  city        String? // Cidade
  state       String? // Estado (ex: SP)
  latitude    Float?  // coordenada — própria da câmera, override do site
  longitude   Float?  // coordenada — própria da câmera, override do site

  // EDGE_BOX = câmera gerenciada por uma edge box local (rtsp pulled pela box,
  //   IA on-device, gravação local + sync cloud); edgeNodeId obrigatório.
  // CLOUD_DIRECT = câmera avulsa conectada direto à cloud (ONVIF/RTSP/RTMP/P2P),
  //   sem hardware no site; edgeNodeId NULL; bandwidth do cliente.
  deploymentMode CameraDeploymentMode @default(EDGE_BOX)

  // ── Streams RTSP (credenciais criptografadas na app layer) ──────────────────
  rtspMainUrl      String // stream principal (alta resolução) — role: record
  rtspSubUrl       String? // sub-stream (baixa res) — role: detect
  rtspUsername     String?
  rtspPasswordEnc  String? // AES-256 encrypted
  rtmpPushUrl      String? // URL de push para Vertex AI Vision
  webrtcIceServers Json? // TURN/STUN customizados (override per-camera)

  // ── go2rtc stream naming (quando o edge publica este fluxo no go2rtc) ────
  go2rtcStreamId String? // nome do stream no go2rtc (ex: "cam-entrada-sub")
  liveMode       LiveMode @default(AUTO) // AUTO = tenta WHEP→MJPEG; apenas WHEP ou apenas MJPEG

  // ── S0: Frigate name mapping ──────────────────────────────────────────────
  // frigateName: nome interno que o Frigate usa para este stream (ex: "camera1").
  //   A Box envia este valor no campo cameraId de POST /iacv-box/events.
  //   Se nulo, o sistema usa go2rtcStreamId como fallback para resolução.
  frigateName String?

  // ── Status & Metadados físicos ─────────────────────────────────────────────
  status          CameraStatus @default(PENDING_CONFIG)
  tier            CameraTier
  pipeline        PipelineType
  brand           String? // "Hikvision", "Intelbras", "Dahua", "Axis"
  model           String? // modelo do equipamento
  firmwareVersion String?
  serialNumber    String?
  macAddress      String?
  resolution      String? // "1920x1080"
  fps             Int?
  codec           String? // "h264" | "h265" | "mjpeg"
  active          Boolean      @default(true)
  lastOnlineAt    DateTime?
  healthScore     Float? // 0-100 (uptime + fps + latência)

  // ── FFmpeg / Hardware Acceleration (Frigate-style) ─────────────────────────
  hwAccel          FfmpegHwAccel @default(NONE)
  ffmpegInputArgs  String? // preset: rtsp-generic | rtsp-restream | http-mjpeg
  ffmpegOutputArgs String? // preset: record-generic-audio-copy
  ffmpegGlobalArgs String? // args extras

  // ── Detector ───────────────────────────────────────────────────────────────
  detectorType              DetectorType @default(CPU)
  detectorWidth             Int          @default(1280)
  detectorHeight            Int          @default(720)
  detectorFps               Int          @default(5)
  detectorEnabled           Boolean      @default(true)
  detectorModelPath         String? // path do modelo ONNX/TFLite no edge node
  detectorModelType         String? // "yolov9" | "yolox" | "ssd-mobilenet" | "yolonas"
  detectStationaryInterval  Int?         @default(50)
  detectStationaryThreshold Int?         @default(50)

  // ── Motion detection (Frigate) ─────────────────────────────────────────────
  motionEnabled         Boolean @default(true)
  motionThreshold       Int     @default(30) // 1-255 (menor = mais sensível)
  motionContourArea     Int     @default(10)
  motionFrameAlpha      Float   @default(0.01)
  motionImproveContrast Boolean @default(true)
  motionLightningThresh Float   @default(0.8)
  motionMaskJson        Json? // polígonos de máscara

  // ── Objects (rastreamento) ─────────────────────────────────────────────────
  objectsTrackJson   Json? // ["person", "car", "bicycle", ...]
  objectsFiltersJson Json? // { person: { min_area, max_area, min_score, threshold, mask } }

  // ── Snapshots ──────────────────────────────────────────────────────────────
  snapshotsEnabled     Boolean @default(true)
  snapshotTimestamp    Boolean @default(false)
  snapshotBoundingBox  Boolean @default(true)
  snapshotCrop         Boolean @default(false)
  snapshotQuality      Int     @default(85) // 1-100
  snapshotHeight       Int     @default(720)
  snapshotRetainDays   Int     @default(10)
  // Sprint Q.3 — Clean copy do snapshot (sem bounding boxes / timestamp).
  // Frigate publica `<id>-clean.webp` para ML downstream e portais públicos
  // que não querem overlays. Quando true, o gravador salva 2 variantes.
  cleanSnapshotEnabled Boolean @default(true)

  // ── Notificações ──────────────────────────────────────────────────────────
  // Sprint Q.5 — Cooldown anti-spam (em segundos) para WebPush/webhook por câmera.
  // Sobrescreve o globalCooldownSec do tenant. 0 = sem cooldown, null = herda do tenant.
  notificationCooldownSec Int? @default(60)

  // ── RTMP push out (broadcast para YouTube/Twitch/Facebook/CDN) ────────────
  // Quando habilitado, o backend adiciona um producer RTMP secundário no
  // stream do go2rtc embarcado: `PUT /api/streams?...&src=rtmp://destino`.
  // go2rtc faz copy do H.264 sem transcode (CPU ~zero) e empurra pro destino.
  // URL completa cifrada (AES-256-GCM) — pode conter stream key sensível
  // (ex: rtmp://a.rtmp.youtube.com/live2/abc-xyz-key).
  rtmpPushUrlEnc  String? // gcm:v1:... — null = sem push configurado
  rtmpPushEnabled Boolean @default(false)

  // ── RTMP push IN (câmera empurra pro VSaaS, atravessa NAT do cliente) ─────
  // Modo de ingestão: RTSP_PULL (default — backend puxa do IP da câmera) OU
  // RTMP_PUSH (câmera é o cliente, abre TCP outbound pro nosso ingest;
  // funciona atrás de qualquer NAT sem hardware/edge físico).
  ingestMode            IngestMode @default(RTSP_PULL)
  // Stream key cifrada (AES-256-GCM). Quem souber a chave em plain pode
  // empurrar stream se autenticando como esta câmera. Rotacionável.
  rtmpIngestKeyEnc      String?
  // Marca o instante do último frame visto pelo go2rtc. Usado pelo job
  // de status pra detectar câmera offline em modo RTMP_PUSH (RTSP_PULL
  // continua usando heartbeat tradicional).
  rtmpIngestLastFrameAt DateTime?

  ingestLogs        IngestLog[]
  recordingSegments RecordingSegment[]
  bookmarks         Bookmark[]
  recordingSchedule RecordingSchedule[]
  detectionFrames   DetectionFrame[]

  // ── Record / Recording retention ───────────────────────────────────────────
  recordEnabled             Boolean       @default(true)
  recordMode                RecordingMode @default(MOTION)
  recordRetainDays          Int           @default(7)
  recordAlertRetainDays     Int           @default(30)
  recordDetectionRetainDays Int           @default(14)
  recordPreCaptureSec       Int           @default(5)
  recordPostCaptureSec      Int           @default(10)

  // ── Live streaming policy (SRT publish mode) ───────────────────────────────
  // AUTO: backend decide com base no #cams da Box (default)
  // ALWAYS: Box mantém SRT publish always-on (instant play, mais bandwidth)
  // ON_DEMAND: Box só publica quando um viewer pede (economiza uplink)
  // SUB_ONLY: nunca publica mainstream — só substream baixa-res sempre
  publishMode               CameraPublishMode @default(AUTO)

  // ── Review (alerts vs detections) ──────────────────────────────────────────
  reviewAlertLabelsJson     Json? // ["person", "car"]
  reviewDetectionLabelsJson Json? // ["dog", "cat", "bicycle"]
  reviewRequiredZonesJson   Json?

  // ── Audio detection (Frigate 0.13+) ────────────────────────────────────────
  audioEnabled     Boolean @default(false)
  audioMinVolume   Int     @default(500)
  audioMaxNotHeard Int     @default(30) // segundos
  audioListenJson  Json? // ["bark","scream","glass_breaking","fire_alarm"]
  audioFiltersJson Json?

  // ── Semantic Search ────────────────────────────────────────────────────────
  semanticSearchEnabled Boolean @default(false)
  semanticModelSize     String  @default("small") // "small" | "large"
  semanticReindex       Boolean @default(false)

  // ── Face Recognition (Vertex AI) ───────────────────────────────────────────
  faceRecognitionEnabled Boolean @default(false)
  faceMinScore           Float   @default(0.80)
  faceUnknownScore       Float   @default(0.80)
  faceDetectionThreshold Float   @default(0.70)
  faceMinCount           Int     @default(1)
  faceSaveAttempts       Int     @default(100)
  faceBlurFilter         Boolean @default(true)

  // ── LPR (License Plate Recognition) ────────────────────────────────────────
  lprEnabled        Boolean @default(false)
  lprMinArea        Int     @default(1000)
  lprThreshold      Float   @default(0.70)
  lprMinPlateLength Int     @default(4)
  lprFormatRegex    String? @default("^[A-Z]{3}[0-9][A-Z0-9][0-9]{2}$") // Mercosul BR
  lprMatchDistance  Int     @default(1)
  lprEnhancement    Int     @default(0) // 0-10

  // ── GenAI (descrições automáticas via Gemini) ──────────────────────────────
  genaiEnabled             Boolean @default(false)
  genaiProvider            String  @default("gemini") // "gemini"|"openai"|"ollama"
  genaiModel               String  @default("gemini-1.5-flash")
  genaiPromptGlobal        String?
  genaiPromptsByObjectJson Json?
  genaiUseSnapshot         Boolean @default(true)

  // ── PTZ / ONVIF + Autotracking ─────────────────────────────────────────────
  onvifHost           String?
  onvifPort           Int?    @default(8000)
  onvifUsername       String?
  onvifPasswordEnc    String?
  ptzEnabled          Boolean @default(false)
  ptzAutotrackEnabled Boolean @default(false)
  ptzZoomFactor       Float?  @default(0.3)
  ptzReturnPreset     String?
  ptzTimeoutSec       Int?    @default(10)
  ptzTrackObjectsJson Json?

  // ── Birdseye ───────────────────────────────────────────────────────────────
  birdseyeEnabled Boolean @default(false)
  birdseyeMode    String  @default("objects") // "continuous"|"motion"|"objects"
  birdseyeOrder   Int?

  // ── Vertex AI Vision (Pipeline 2) ──────────────────────────────────────────
  vertexStreamId    String? // projects/P/locations/L/streams/S
  vertexAppId       String? // projects/P/locations/L/applications/A
  vertexProcessId   String? // processo em execução no Vertex
  bqDatasetId       String?
  bqTableId         String?
  visionWarehouseId String?

  // ── Snapshot atual ─────────────────────────────────────────────────────────
  lastSnapshotUrl String?
  lastSnapshotAt  DateTime?

  // ── Alert watchdog — controle de cooldown por câmera ───────────────────────
  // Atualizado pelo camera-watchdog.service quando dispara alerta de offline.
  // Lido pelo alert.service para saber se já foi notificado recentemente.
  lastAlertSentAt    DateTime? // quando foi enviado o último alerta desta câmera
  alertSuppressUntil DateTime? // suprimir alertas desta câmera até este momento

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  site            Site                   @relation(fields: [siteId], references: [id])
  // Composite FK: garante que a câmera e o edge estejam no MESMO site.
  // Bloqueia no banco qualquer fluxo (POST sem validação, mover EdgeNode,
  // SQL ad-hoc, seed antigo) que tente vincular câmera a edge de outro tenant.
  edgeNode        EdgeNode?              @relation(fields: [siteId, edgeNodeId], references: [siteId, id])
  zones           CameraZone[]
  enabledModels   CameraModel[]
  analyticsEvents AnalyticsEvent[]
  subscription    CameraSubscription?
  peopleCountings PeopleCounting[]
  heatmaps        HeatmapSnapshot[]
  apiUsageLogs    ApiUsageLog[]
  logs            CameraLog[]
  streamTests     CameraStreamTest[]
  alertRules      CameraAlertRule[]
  reviewItems     ReviewItem[]
  faceEvents      FaceRecognitionEvent[]
  plateEvents     LicensePlateEvent[]
  audioEvents     AudioDetectionEvent[]
  semanticEmbeds  SemanticEmbedding[]
  storageUsage    StorageUsage[]
  floorPlanCameras FloorPlanCamera[]

  // Evita duas câmeras com o MESMO nome no MESMO site — confundia o operador
  // (eram exibidas como linhas idênticas, sem ID na lista). Continua aceitando
  // o mesmo nome em sites distintos do mesmo ou de outro tenant.
  @@unique([siteId, name], name: "Camera_siteId_name_unique")
  @@index([siteId])
  @@index([edgeNodeId])
  @@index([tier, pipeline])
  @@index([status])
  @@index([active, status])
}

// =============================================================================
// MAPA SINÓTICO (Floor Plan)
// =============================================================================

/// Planta baixa / mapa interno de um site com câmeras posicionadas
model FloorPlan {
  id          String   @id @default(cuid())
  tenantId    String
  siteId      String?
  name        String
  imageUrl    String   // URL da imagem da planta (após upload direto para R2/S3)
  imageWidth  Int?     // px originais (para referência de escala)
  imageHeight Int?     // px originais (para referência de escala)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  site    Site?             @relation(fields: [siteId], references: [id])
  cameras FloorPlanCamera[]

  @@index([tenantId])
  @@index([siteId])
}

/// Posição de uma câmera dentro de uma planta baixa
model FloorPlanCamera {
  id          String  @id @default(cuid())
  floorPlanId String
  cameraId    String
  xPct        Float   // posição X em % (0–100) relativa à imagem
  yPct        Float   // posição Y em % (0–100) relativa à imagem
  label       String? // override do nome da câmera exibido na planta

  createdAt DateTime @default(now())

  floorPlan FloorPlan @relation(fields: [floorPlanId], references: [id], onDelete: Cascade)
  camera    Camera    @relation(fields: [cameraId], references: [id], onDelete: Cascade)

  @@unique([floorPlanId, cameraId])
  @@index([floorPlanId])
  @@index([cameraId])
}

/// Zona de analytics desenhada sobre a câmera — Frigate-inspired
model CameraZone {
  id          String   @id @default(uuid())
  cameraId    String
  name        String // "Tripwire Entrada", "Praça Sul", "Zona EPI"
  type        ZoneType
  color       String?  @default("#06b6d4")
  // Array de pontos normalizados [{x: 0.1, y: 0.2}, ...] (0.0–1.0)
  coordinates Json
  // Para COUNTING_LINE
  direction   String? // "IN" | "OUT" | "BOTH"

  // ── Frigate zone semantics ────────────────────────────────────────────────
  inertia          Int?    @default(3) // frames para confirmar entrada
  loiteringTimeSec Int?    @default(0) // tempo mínimo parado na zona
  objectsJson      Json? // objetos permitidos ["person","car"]
  filtersJson      Json? // { person: { min_area, max_area, threshold } }
  distancesJson    Json? // [d1,d2,d3,d4] para speed calc
  requiredForAlert Boolean @default(false) // zona obrigatória para virar alerta

  // Alertas por zona
  alertOnViolation Boolean  @default(false)
  maxOccupancy     Int?
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  camera          Camera           @relation(fields: [cameraId], references: [id], onDelete: Cascade)
  analyticsEvents AnalyticsEvent[]
  peopleCountings PeopleCounting[]

  @@index([cameraId])
}

/// Modelos de IA habilitados por câmera
model CameraModel {
  id        String         @id @default(uuid())
  cameraId  String
  model     AnalyticsModel
  enabled   Boolean        @default(true)
  // Config específica do modelo (thresholds, classes, etc.)
  config    Json?
  createdAt DateTime       @default(now())

  camera Camera @relation(fields: [cameraId], references: [id])

  @@unique([cameraId, model])
  @@index([cameraId])
}

// =============================================================================
// BILLING & QUOTA — Proteção de custos GCP
// =============================================================================

/// Assinatura/plano de cada câmera
model CameraSubscription {
  id                      String       @id @default(uuid())
  cameraId                String       @unique
  tier                    CameraTier
  // Static Vision: limite mensal de chamadas Vision API
  monthlyApiLimit         Int?
  // Streaming Analytics: limite mensal em horas de stream
  monthlyStreamHoursLimit Float?
  priceMonthlyBrl         Decimal      @db.Decimal(10, 2)
  billingCycle            BillingCycle @default(MONTHLY)
  startDate               DateTime
  renewDate               DateTime
  active                  Boolean      @default(true)
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  camera Camera @relation(fields: [cameraId], references: [id])
}

/// Cota de API por Integrador (proteção de faturamento GCP)
model ApiQuota {
  id           String @id @default(uuid())
  integradorId String

  // Static Vision (Cloud Vision API)
  staticVisionMonthlyLimit  Int @default(50000) // chamadas/mês
  staticVisionUsedThisMonth Int @default(0)

  // Streaming Analytics (Vertex AI Vision) — minutos
  streamingMinutesLimit Float @default(6000) // min/mês ≈ 100h
  streamingMinutesUsed  Float @default(0)

  // Política de bloqueio
  blockPolicy      QuotaBlockPolicy @default(HARD_BLOCK)
  warningThreshold Int              @default(80) // % para alertar
  hardLimitEnabled Boolean          @default(true)

  // Período de referência
  periodStart DateTime
  periodEnd   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  integrador Integrador @relation(fields: [integradorId], references: [id])

  @@unique([integradorId, periodStart])
  @@index([integradorId])
}

/// Log granular de uso de API (por chamada ou por minuto de stream)
model ApiUsageLog {
  id           String  @id @default(uuid())
  integradorId String
  cameraId     String?
  edgeNodeId   String?

  // Cloud Vision API
  visionApiCalls     Int      @default(0)
  visionFeaturesJson Json? // {"FACE_DETECTION":5,"LABEL_DETECTION":5}
  visionCostUsd      Decimal? @db.Decimal(12, 6)

  // Vertex AI Vision
  vertexStreamMinutes Float    @default(0)
  vertexCostUsd       Decimal? @db.Decimal(12, 6)

  // GCS (armazenamento de evidências)
  gcsObjectsStored Int      @default(0)
  gcsSizeBytes     BigInt   @default(0)
  gcsCostUsd       Decimal? @db.Decimal(12, 6)

  // Controle de frames ignorados (economia)
  framesSkipped  Int @default(0) // frames sem contexto humano — sem custo
  framesUploaded Int @default(0) // frames enviados à GCP

  recordedAt DateTime @default(now())
  periodDate DateTime // YYYY-MM-01 (para agregação mensal)

  integrador Integrador @relation(fields: [integradorId], references: [id])
  camera     Camera?    @relation(fields: [cameraId], references: [id])
  edgeNode   EdgeNode?  @relation(fields: [edgeNodeId], references: [id])

  @@index([integradorId, periodDate])
  @@index([cameraId, recordedAt])
  @@index([edgeNodeId, recordedAt])
}

/// Fatura mensal por Integrador
model Invoice {
  id           String   @id @default(uuid())
  integradorId String
  periodStart  DateTime
  periodEnd    DateTime

  // Contagem de câmeras no período
  totalCamerasStatic    Int @default(0)
  totalCamerasStreaming Int @default(0)

  // Volumes de consumo
  visionApiCalls      Int   @default(0)
  vertexStreamMinutes Float @default(0)
  gcsTotalGb          Float @default(0)

  // Valores
  totalAmountBrl Decimal @db.Decimal(10, 2)
  gcpCostUsd     Decimal @db.Decimal(10, 4)
  marginPercent  Float?

  status    String    @default("PENDING") // PENDING | PAID | OVERDUE | CANCELLED
  paidAt    DateTime?
  dueDate   DateTime?
  createdAt DateTime  @default(now())

  integrador Integrador @relation(fields: [integradorId], references: [id])

  @@index([integradorId, periodStart])
  @@index([status])
}

// =============================================================================
// ANALYTICS DATA — Apenas metadados anonimizados (LGPD)
// =============================================================================

/// Evento de analytics detectado (metadados — sem PII)
model AnalyticsEvent {
  id       String  @id @default(uuid())
  cameraId String?  // nullable: eventos de edge box sem câmera mapeada no DB
  zoneId   String?

  // Contexto do evento
  model     AnalyticsModel
  pipeline  PipelineType
  eventType String // "PERSON_DETECTED" | "PPE_VIOLATION" | "CROWD_ALERT" | "EMOTION_PEAK" | "LOGO_SEEN"
  severity  EventSeverity  @default(INFO)

  // Temporal
  capturedAt   DateTime
  processedAt  DateTime @default(now())
  dwellTimeSec Float? // segundos de permanência na zona

  // Dados demográficos anonimizados (sem biometria)
  ageRange String? // "18-24" | "25-34" | "35-44" | "45-54" | "55+"
  gender   String? // "MALE" | "FEMALE" | "UNKNOWN"

  // Emoções (FaceAnnotation)
  emotionJoy      Float? // 0.0–1.0
  emotionSorrow   Float?
  emotionAnger    Float?
  emotionSurprise Float?
  emotionNeutral  Float?
  dominantEmotion String?

  // Acessórios detectados
  hasHat        Boolean?
  hasGlasses    Boolean?
  hasFaceMask   Boolean?
  headwearScore Float?

  // Labels de roupa/itens (LabelDetection)
  labelsJson Json? // ["blue shirt", "shopping bag", "Nike sneakers"]

  // Logos detectados (LogoDetection) — eficácia de sacolas
  logosJson Json? // [{"description":"Nike","score":0.97}]

  // Contagem
  personCount  Int?
  vehicleCount Int?

  // PPE (Vertex AI)
  ppeCompliant   Boolean?
  ppeMissingJson Json? // ["hard hat", "safety vest"]

  // Ocupação / Dwell (Occupancy Analytics)
  occupancyCount Int?
  avgDwellSec    Float?

  // Objetos detectados (YOLOv8 local ou Vertex)
  detectedObjectsJson Json? // [{label, score, bbox:{x,y,w,h}}]

  // Evidência probatória (GCS — TTL 72h — LGPD)
  evidenceGcsBucket String?
  evidenceGcsKey    String? // objeto deletado automaticamente após TTL
  evidenceExpiry    DateTime?

  // Sync BigQuery (Pipeline 2)
  bqSyncedAt DateTime?
  bqInsertId String?

  // Resposta bruta anonimizada do GCP
  rawAnnotationsJson Json?

  // Idempotência: edge pode reenviar o mesmo crop em caso de retry/timeout.
  // Combinada com cameraId no UNIQUE abaixo, garante que duas requests com
  // a mesma chave devolvem o evento original (sem dupla cobrança Vision).
  idempotencyKey String?

  // ── S0: Box-side fields ────────────────────────────────────────────────────
  // edgeNodeId: Box que gerou o evento (complementa cameraId quando câmera não mapeada).
  edgeNodeId String?

  // frigateId: ID interno do Frigate (ex: "1714435200.abc-camera1").
  //   Chave de idempotência Box-side — evita duplicata em store-and-forward retries.
  //   UNIQUE por edgeNodeId+frigateId (partial index — só quando ambos não são NULL).
  frigateId String?

  // ── Vault (Cloudflare R2) — S0 ────────────────────────────────────────────
  // Chaves R2 para os arquivos de mídia do evento (preenchidos pela Box após upload).
  vaultSnapshotKey String?  // ex: "events/{boxId}/{frigateId}/snapshot.jpg"
  vaultClipKey     String?  // ex: "events/{boxId}/{frigateId}/clip.mp4"
  vaultFaceKey     String?  // ex: "events/{boxId}/{frigateId}/face.jpg"
  vaultPlateKey    String?  // ex: "events/{boxId}/{frigateId}/plate.jpg"
  vaultUploadedAt  DateTime? // quando a Box confirmou upload para o vault

  camera Camera?     @relation(fields: [cameraId], references: [id])
  zone   CameraZone? @relation(fields: [zoneId], references: [id])

  @@unique([cameraId, idempotencyKey], name: "AnalyticsEvent_camera_idempotency")
  @@index([cameraId, capturedAt])
  @@index([zoneId, capturedAt])
  @@index([edgeNodeId, capturedAt])
  @@index([model, capturedAt])
  @@index([eventType, capturedAt])
  @@index([evidenceExpiry]) // para job de limpeza LGPD
}

/// Snapshot de mapa de calor agregado
model HeatmapSnapshot {
  id         String   @id @default(uuid())
  cameraId   String
  zoneId     String?
  date       DateTime
  period     String // "hourly" | "daily" | "weekly"
  // Grid normalizado de densidade [[0.0–1.0]] (NxM)
  gridData   Json
  maxDensity Float
  minDensity Float
  createdAt  DateTime @default(now())

  camera Camera @relation(fields: [cameraId], references: [id])

  @@index([cameraId, date, period])
}

/// Contagem de pessoas por janela de tempo e zona
model PeopleCounting {
  id          String   @id @default(uuid())
  cameraId    String
  zoneId      String?
  entryCount  Int      @default(0)
  exitCount   Int      @default(0)
  netFlow     Int      @default(0) // entradas - saídas
  peakCount   Int? // pico de ocupação na janela
  windowStart DateTime
  windowEnd   DateTime
  granularity String // "1min" | "5min" | "15min" | "1hour" | "1day"
  createdAt   DateTime @default(now())

  camera Camera      @relation(fields: [cameraId], references: [id])
  zone   CameraZone? @relation(fields: [zoneId], references: [id])

  @@index([cameraId, windowStart, granularity])
  @@index([zoneId, windowStart])
}

// =============================================================================
// AUDITORIA & LGPD
