  MULTIPLE_MATCHES
}

enum PlateCategory {
  AUTHORIZED // Veículo autorizado (morador, funcionário)
  VIP // VIP / executivo
  FLEET // Frota corporativa
  SERVICE // Prestador de serviço
  BLACKLIST // Placa proibida / alerta de segurança
