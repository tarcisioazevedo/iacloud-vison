# ─── Banco de Dados ───────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/iacloudvision"

# ─── JWT ──────────────────────────────────────────────────
JWT_SECRET="trocar-por-segredo-forte-256bits"
JWT_EXPIRES_IN="8h"

# ─── Google Cloud Platform ────────────────────────────────
GOOGLE_APPLICATION_CREDENTIALS="./gcp-service-account.json"
GCP_PROJECT_ID="iacloud-vision-prod"
GCP_LOCATION="us-central1"

# ─── GCS (Evidências + Lifecycle 72h) ─────────────────────
GCS_EVIDENCE_BUCKET="iacloud-evidence-raw"
GCS_EVIDENCE_TTL_HOURS=72

# ─── Vertex AI Vision ─────────────────────────────────────
VERTEX_VISION_ENDPOINT="visionai.googleapis.com"
VERTEX_VISION_LOCATION="us-central1"

# ─── BigQuery ─────────────────────────────────────────────
BQ_DATASET_DEFAULT="iacloud_analytics"

# ─── Sentry (Observabilidade) ─────────────────────────────
# DSN do projeto backend no Sentry (Settings > Client Keys).
# Em Docker Swarm: usar docker secret SENTRY_DSN_BACKEND.
SENTRY_DSN_BACKEND=""
SENTRY_RELEASE=""
SENTRY_TRACES_SAMPLE_RATE=0.2
SENTRY_PROFILES_SAMPLE_RATE=0.2

# ─── Servidor ─────────────────────────────────────────────
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# ─── Rate Limiting ────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ─── Telegram Bot (Notificações) ─────────────────────────
# Crie um bot em https://t.me/BotFather e cole o token aqui.
# Sem token → notificações Telegram desabilitadas (WebPush continua).
TELEGRAM_BOT_TOKEN=""

# ─── Cloudflare R2 (Multi-Tenant Storage) ─────────────────
# Usado para isolamento de storage por integrador/cliente.
# Se não configurado, cai no S3 legado (ICV_S3_*).
R2_ACCOUNT_ID=""
R2_API_TOKEN=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
R2_BUCKET_TEMPLATE="icv-{integradorId}"

# ─── S3 (Legado / Fallback) ───────────────────────────────
ICV_S3_ENDPOINT="https://fsn1.your-objectstorage.com"
ICV_S3_ACCESS_KEY=""
ICV_S3_SECRET_KEY=""
ICV_S3_BUCKET="icv-iacloud-vision"
ICV_S3_REGION="fsn1"
