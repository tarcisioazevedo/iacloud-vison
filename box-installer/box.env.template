# IA Cloud Vision — Box .env
# Preencha após instalação. A Box também aceita estas vars via UI first-boot.

# Tag da imagem do backend (latest = release stable)
BOX_BACKEND_TAG=latest

# Verbosity dos logs: debug | info | warn | error
BOX_LOG_LEVEL=info

# URL da Cloud (não alterar em produção)
BOX_CLOUD_BASE_URL=https://app.iacloud.com.br

# (opcional) Pré-popular a licença para skip do wizard:
# BOX_LICENSE_KEY=IACV-XXXX-XXXX-XXXX-XXXX
