# =============================================================================
# VSaaS — docker-stack.yml.example (TEMPLATE)
#
# Este arquivo é um TEMPLATE sanitizado. Todas as credenciais foram trocadas
# por placeholders 'CHANGE_ME_*'. Use como referência pra entender estrutura.
#
# Como gerar seu docker-stack.yml real:
#   1. cp docker-stack.yml.example docker-stack.yml
#   2. Trocar TODOS os 'CHANGE_ME_*' por credenciais reais
#   3. Manter docker-stack.yml FORA do git (já está no .gitignore quando rotação P0 estiver feita)
#
# Como rotacionar cada credencial:
#   docs/PRE-HOMOLOGACAO-CHECKLIST.md → seção '🔴 P0 — Rotação obrigatória'
#
# Gerado automaticamente em 2026-05-12 via sed do docker-stack.yml com
# credenciais reais substituídas. Idempotente — rodar de novo regenera.
# =============================================================================

version: '3.9'

# =============================================================================
# IA Cloud Vision — Docker Swarm Stack
# Deploy: ./deploy.sh
# Update:  docker stack deploy -c docker-stack.yml iacloud
# Remove:  docker stack rm iacloud
# Logs:    docker service logs iacloud_backend -f
#
# VPS: Hetzner CPX42 — 8 vCPU / 16 GB RAM
# Capacidade estimada:
#   - 150-200 câmeras com streaming simultâneo (gargalo: ~400 Mbps banda)
#   - 500+ câmeras cadastradas
#   - ~50.000 eventos/hora
# Alocação de memória (limites):
#   backend 4096M + go2rtc 4096M + postgres 1536M + redis 512M
#   + mediamtx 768M + evolution 512M + mqtt 256M + frontend 256M + pgbouncer 128M
#   ≈ 12.1 GB → deixa ~3.9 GB para OS, Docker overhead e picos
# =============================================================================

networks:
  icv_net:
    driver: overlay
    attachable: true   # permite `docker run --network icv_net` para debug

volumes:
  postgres_data:
    driver: local
  redis_data:
    driver: local
  evolution_instances:
    driver: local
  mqtt_data:
    driver: local
  mqtt_log:
    driver: local
configs:
  mosquitto_conf:
    file: ./vsaas-backend/mosquitto/mosquitto.conf
  go2rtc_config_v65:
    external: true
  mediamtx_config_v13:
    external: true

secrets:
  jwt_secret:
    file: ./secrets/jwt_secret.txt
  smtp_pass:
    file: ./secrets/smtp_pass.txt
  db_password:
    file: ./secrets/db_password.txt
  vapid_public:
    file: ./secrets/vapid_public.txt
  vapid_private:
    file: ./secrets/vapid_private.txt
  icv_encryption_key:
    file: ./secrets/icv_encryption_key.txt
  # Secrets externos — criados via `docker secret create iacloud_<nome> ...`
  # (não vão para git, gerenciados manualmente no Swarm).
  iacloud_cloudflare_api_token:
    external: true
  iacloud_cloudflare_account_id:
    external: true
  iacloud_cloudflare_zone_id:
    external: true
  iacloud_srt_publish_passphrase:
    external: true

services:

  # ── PostgreSQL ──────────────────────────────────────────────────────────────
  postgres:
    image: postgres:16-alpine
    # Tuning para 1536M RAM alocado: shared_buffers=25%, effective_cache=75%
    command: >
      postgres
      -c shared_buffers=384MB
      -c effective_cache_size=1152MB
      -c work_mem=16MB
      -c maintenance_work_mem=128MB
      -c max_connections=200
      -c wal_buffers=16MB
      -c checkpoint_completion_target=0.9
      -c random_page_cost=1.1
      -c effective_io_concurrency=200
      -c log_min_duration_statement=1000
    environment:
      POSTGRES_USER: icvuser
      POSTGRES_PASSWORD_FILE: /run/secrets/db_password
      POSTGRES_DB: iacloudvision
    secrets:
      - db_password
    volumes:
      - postgres_data:/var/lib/postgresql/data
    networks:
      icv_net:
        aliases:
          - postgres
    deploy:
      replicas: 1
      placement:
        constraints: [node.role == manager]   # stateful — sempre no mesmo nó
      restart_policy:
        condition: any            # restart sempre (incl. reboots seguidos do host)
        delay: 10s
        # max_attempts removido: reboots seguidos do host não devem zerar o serviço
      resources:
        limits:
          memory: 1536M
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U icvuser -d iacloudvision"]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 30s

  # ── PgBouncer (Pool de Conexões Postgres) ──────────────────────────────────
  pgbouncer:
    image: edoburu/pgbouncer:latest
    environment:
      DB_HOST: postgres
      DB_USER: icvuser
      DB_PASSWORD: "CHANGE_ME_POSTGRES_PASSWORD"
      POOL_MODE: transaction
      MAX_CLIENT_CONN: 1000
      DEFAULT_POOL_SIZE: 50
    networks:
      icv_net:
        aliases:
          - pgbouncer
    deploy:
      replicas: 1
      placement:
        constraints: [node.role == manager]
      restart_policy:
        condition: on-failure
        delay: 5s
      resources:
        limits:
          memory: 128M
    depends_on:
      - postgres

  # ── Redis ───────────────────────────────────────────────────────────────────
  redis:
    image: redis:7-alpine
    command: redis-server --maxmemory 384mb --maxmemory-policy allkeys-lru
    volumes:
      - redis_data:/data
    networks:
      icv_net:
        aliases:
          - redis
    deploy:
      replicas: 1
      placement:
        constraints: [node.role == manager]
      restart_policy:
        condition: on-failure
        delay: 5s
      resources:
        limits:
          memory: 512M
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 10s
      timeout: 3s
      retries: 5

  # ── MQTT Broker ─────────────────────────────────────────────────────────────
  mqtt:
    image: eclipse-mosquitto:2.0
    configs:
      - source: mosquitto_conf
        target: /mosquitto/config/mosquitto.conf
    volumes:
      - mqtt_data:/mosquitto/data
      - mqtt_log:/mosquitto/log
    ports:
      - target: 1883
        published: 1883
        mode: host      # mode host para menor latência de IoT
      - target: 9001
        published: 9001
        mode: host      # WebSocket para dashboard web
    networks:
      - icv_net
    deploy:
      replicas: 1
      placement:
        constraints: [node.role == manager]
      restart_policy:
        condition: on-failure
      resources:
        limits:
          memory: 256M

  # ── Evolution API (WhatsApp) ─────────────────────────────────────────────────
  evolution:
    image: atendai/evolution-api:v2.2.3
    environment:
      SERVER_URL: https://evolution.iacloud.com.br
      CORS_ORIGIN: "*"
      CORS_METHODS: "POST,GET,PUT,DELETE"
      CORS_CREDENTIALS: "true"
      AUTHENTICATION_TYPE: apikey
      AUTHENTICATION_API_KEY: "CHANGE_ME_EVOLUTION_KEY"
      AUTHENTICATION_EXPOSE_IN_FETCH_INSTANCES: "true"
      DATABASE_ENABLED: "true"
      DATABASE_PROVIDER: postgresql
      # IMPORTANTE: Evolution usa DB DEDICADA (`evolution_db`) — não compartilha com `iacloudvision`.
      # Ele tem ~50 migrations próprias (Instance, IntegrationSession, Setting, Chat, Message, etc.)
      # que coalisariam com o schema do nosso VSaaS se rodassem na mesma DB.
      # Migration aplicada em prod 2026-05-06 (vide handoff do dia).
      DATABASE_CONNECTION_URI: postgresql://icvuser:CHANGE_ME_POSTGRES_PASSWORD@postgres:5432/evolution_db
      DATABASE_CONNECTION_CLIENT_NAME: evolution
      DATABASE_SAVE_DATA_INSTANCE: "true"
      DATABASE_SAVE_DATA_NEW_MESSAGE: "false"
      DATABASE_SAVE_MESSAGE_UPDATE: "false"
      DATABASE_SAVE_DATA_CONTACTS: "false"
      DATABASE_SAVE_DATA_CHATS: "false"
      DATABASE_SAVE_DATA_LABELS: "false"
      DATABASE_SAVE_DATA_HISTORIC: "false"
      CACHE_REDIS_ENABLED: "true"
      CACHE_REDIS_URI: redis://redis:6379
      CACHE_REDIS_PREFIX_KEY: "evolution"
      CACHE_REDIS_SAVE_INSTANCES: "false"
      LOG_LEVEL: ERROR
      LOG_COLOR: "true"
      LOG_BAILEYS: "error"
      QRCODE_LIMIT: 30
      QRCODE_COLOR: "#198754"
      DEL_INSTANCE: "false"
    volumes:
      - evolution_instances:/evolution/instances
    ports:
      - target: 8080
        published: 8081
        mode: host
    networks:
      icv_net:
        aliases:
          - evolution
    deploy:
      replicas: 1
      placement:
        constraints: [node.role == manager]
      restart_policy:
        condition: on-failure
        delay: 10s
      resources:
        limits:
          memory: 512M

  # ── Backend VSaaS ───────────────────────────────────────────────────────────
  backend:
    image: icv_backend:latest   # construído pelo deploy.sh
    environment:
      NODE_ENV: production
      # Controla heap V8 do Node.js — GC antes de atingir o limite do container (4096M)
      # Deixa ~512M de headroom para buffers nativos, RSS não-heap e libuv.
      NODE_OPTIONS: "--max-old-space-size=3584"
      # G11 fix (2026-05-09): força UTC. ffmpeg `-strftime 1` usa localtime do
      # container; sem TZ=UTC os paths .ts ficavam com fuso BR enquanto o DB
      # guardava UTC, gerando inconsistência sutil entre filesystem e DB.
      TZ: UTC
      PORT: "3000"
      DATABASE_URL: postgresql://icvuser:CHANGE_ME_POSTGRES_PASSWORD@postgres:5432/iacloudvision
      DIRECT_URL: postgresql://icvuser:CHANGE_ME_POSTGRES_PASSWORD@postgres:5432/iacloudvision
      JWT_SECRET: "CHANGE_ME_GENERATE_WITH_openssl_rand_-base64_48"
      JWT_EXPIRES_IN: "8h"
      LOG_LEVEL: info
      RATE_LIMIT_WINDOW_MS: "60000"
      RATE_LIMIT_MAX_REQUESTS: "200"
      GCP_PROJECT_ID: gen-lang-client-0913190127
      GCP_LOCATION: us-central1
      GCS_EVIDENCE_BUCKET: iacloud-evidence-raw
      GCS_EVIDENCE_TTL_HOURS: "72"
      VERTEX_VISION_ENDPOINT: visionai.googleapis.com
      VERTEX_VISION_LOCATION: us-central1
      BQ_DATASET_DEFAULT: iacloud_analytics
      SMTP_HOST: mail.iacloud.com.br
      SMTP_PORT: "587"
      SMTP_SECURE: "false"
      SMTP_USER: iacloudvision@iacloud.com.br
      SMTP_PASS: "CHANGE_ME_SMTP_PASSWORD"
      SMTP_FROM: "IA Cloud Vision <iacloudvision@iacloud.com.br>"
      PUBLIC_FRONTEND_URL: https://app.iacloud.com.br/login
      PUBLIC_BACKEND_URL: https://app.iacloud.com.br/api
      EVOLUTION_API_URL: http://evolution:8080
      EVOLUTION_API_KEY: "CHANGE_ME_EVOLUTION_KEY"
      RTMP_INGEST_PUBLIC_HOST: app.iacloud.com.br
      RTMP_INGEST_PUBLIC_PORT: "1935"
      GO2RTC_API_URL: http://go2rtc:1984
      EMBEDDED_GO2RTC_URL: http://go2rtc:1984
      MEDIAMTX_INTERNAL_URL: http://mediamtx:8889
      # Passphrase SRT publish — backend lê do secret e retorna em /iacv-box/srt-config
      SRT_PUBLISH_PASSPHRASE_FILE: /run/secrets/iacloud_srt_publish_passphrase
      ICV_ENCRYPTION_KEY: "CHANGE_ME_AES256_HEX_openssl_rand_-hex_32"
      GOOGLE_APPLICATION_CREDENTIALS: /run/secrets/gcp_sa   # S1: adicionar secret GCP
      VAPID_PUBLIC_KEY: CHANGE_ME_VAPID_PUBLIC_KEY
      VAPID_PRIVATE_KEY: CHANGE_ME_VAPID_PRIVATE_KEY
      VAPID_SUBJECT: mailto:iacloudvision@iacloud.com.br
      # Cloudflare R2 Multi-Tenant Storage (bucket-per-integrador)
      R2_ACCOUNT_ID: "3f5ec041eda55f11f99f5b96f600378e"
      R2_ACCESS_KEY_ID: "CHANGE_ME_R2_ACCESS_KEY_ID"
      R2_SECRET_ACCESS_KEY: "CHANGE_ME_R2_SECRET_ACCESS_KEY"
      R2_ENDPOINT: "https://3f5ec041eda55f11f99f5b96f600378e.r2.cloudflarestorage.com"
      R2_BUCKET_PREFIX: "icv"
      # Gravação contínua — DESLIGADA para reset/refactor do pipeline (2026-05-09).
      # Reativar somente após Onda 1 do plano de ajustes (G1+G7+G9, G4, G5+G16, G3, G2).
      # Ver docs/PRE-HOMOLOGACAO-CHECKLIST.md.
      RECORDING_ENABLED: "false"
      RECORDINGS_BASE_PATH: /recordings
      RECORDING_SEGMENT_SECONDS: "6"
      GO2RTC_RTSP_URL: rtsp://go2rtc:8554
      # Hetzner Object Storage (S3-compatible) para gravações
      # Endpoint por região: fsn1/nbg1/hel1.your-objectstorage.com
      S3_ENDPOINT: "${S3_ENDPOINT:-}"
      S3_REGION: "${S3_REGION:-fsn1}"
      S3_ACCESS_KEY_ID: "${S3_ACCESS_KEY_ID:-}"
      S3_SECRET_ACCESS_KEY: "${S3_SECRET_ACCESS_KEY:-}"
      S3_RECORDINGS_BUCKET: "${S3_RECORDINGS_BUCKET:-icv-recordings}"
      # Deleta arquivo local após upload S3 confirmado (economiza disco)
      RECORDING_DELETE_LOCAL_AFTER_S3: "true"
      # Cloudflare Tunnel — expõe go2rtc de Edge Boxes via tunnel seguro.
      # Credenciais via Docker Swarm secrets (não em plaintext) — service lê <NAME>_FILE.
      CLOUDFLARE_ACCOUNT_ID_FILE: /run/secrets/iacloud_cloudflare_account_id
      CLOUDFLARE_API_TOKEN_FILE:  /run/secrets/iacloud_cloudflare_api_token
      CLOUDFLARE_ZONE_ID_FILE:    /run/secrets/iacloud_cloudflare_zone_id  # CNAMEs *.tunnels.iacloud.com.br
    secrets:
      - jwt_secret
      - smtp_pass
      - db_password
      - vapid_public
      - vapid_private
      - iacloud_cloudflare_api_token
      - iacloud_cloudflare_account_id
      - iacloud_cloudflare_zone_id
      - iacloud_srt_publish_passphrase
    volumes:
      - ./vsaas-backend/gcp-service-account.json:/run/secrets/gcp_sa:ro
      - /var/run/docker.sock:/var/run/docker.sock
      - ./scripts/update-go2rtc-config.sh:/app/scripts/update-go2rtc-config.sh:ro
      - type: tmpfs
        target: /recordings
        tmpfs:
          size: 4294967296   # 4 GB RAM — ~267 câmeras FHD simultâneas por tick
    ports:
      - target: 3000
        published: 3000
        mode: host
    networks:
      - icv_net
    deploy:
      replicas: 1
      placement:
        constraints: [node.role == manager]
      restart_policy:
        condition: on-failure
        delay: 15s
        max_attempts: 5
      update_config:
        parallelism: 1
        delay: 10s
        failure_action: rollback
        order: stop-first   # host-mode ports exigem stop-first para evitar conflito
      resources:
        limits:
          memory: 4096M
    healthcheck:
      test: ["CMD-SHELL", "wget -qO- http://localhost:3000/health || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 60s

  # ── go2rtc (RTMP ingest + WebRTC/HLS streaming) ─────────────────────────────
  go2rtc:
    image: alexxit/go2rtc:latest
    configs:
      - source: go2rtc_config_v65
        target: /config/go2rtc.yaml
    ports:
      - target: 1935
        published: 1935
        mode: host      # RTMP ingest — câmeras empurram aqui
      - target: 1984
        published: 1984
        mode: host      # API interna
      - target: 8554
        published: 8554
        mode: host      # RTSP out
      - target: 8555
        published: 8555
        protocol: udp
        mode: host      # WebRTC UDP
      - target: 8555
        published: 8555
        protocol: tcp
        mode: host      # WebRTC TCP fallback
      # Nota: SRT NÃO é exposto pelo go2rtc 1.9.x (sem suporte nativo).
      # Quem aceita SRT push é o iacloud_mediamtx na porta 8890/UDP.
    networks:
      icv_net:
        aliases:
          - go2rtc
    deploy:
      replicas: 1
      placement:
        constraints: [node.role == manager]
      restart_policy:
        condition: on-failure
        delay: 5s
      resources:
        limits:
          memory: 4096M
        reservations:
          memory: 256M

  # ── Frontend VSaaS ──────────────────────────────────────────────────────────
  frontend:
    image: icv_frontend:latest   # construído pelo deploy.sh
    environment:
      NODE_ENV: production
    ports:
      - target: 8080
        published: 8082
        mode: host
    networks:
      - icv_net
    deploy:
      replicas: 1
      restart_policy:
        condition: on-failure
        delay: 10s
      update_config:
        parallelism: 1
        delay: 10s
        failure_action: rollback
        order: start-first
      resources:
        limits:
          memory: 256M

  # ─── MediaMTX — SFU para SRT (uplink Box→Cloud, baixa latência) + WebRTC saída ───
  mediamtx:
    image: bluenviron/mediamtx:1.18.1-ffmpeg
    configs:
      - source: mediamtx_config_v13
        target: /mediamtx.yml
    secrets:
      - source: iacloud_srt_publish_passphrase
        target: srt_publish_passphrase
    # Entrypoint wrapper: lê secret do arquivo, exporta como env MTX_*, exec mediamtx.
    # MediaMTX 1.18+ aceita override de config via env MTX_<UPPERCASE_KEY>.
    # `srtPublishPassphrase` (camel) → MTX_SRTPUBLISHPASSPHRASE.
    entrypoint:
      - sh
      - -c
      - |
        # MediaMTX env var sintaxe: MTX_<NESTED_KEY> com `_` separando níveis.
        # `pathDefaults.srtPublishPassphrase` → MTX_PATHDEFAULTS_SRTPUBLISHPASSPHRASE
        export MTX_PATHDEFAULTS_SRTPUBLISHPASSPHRASE=$$(cat /run/secrets/srt_publish_passphrase 2>/dev/null || echo "")
        if [ -z "$$MTX_PATHDEFAULTS_SRTPUBLISHPASSPHRASE" ]; then
          echo "WARN: srt_publish_passphrase secret empty — SRT will accept any client (DEV ONLY)"
        else
          echo "INFO: SRT publish passphrase loaded ($${#MTX_PATHDEFAULTS_SRTPUBLISHPASSPHRASE} chars) — applied to pathDefaults"
        fi
        exec /mediamtx /mediamtx.yml
    ports:
      - target: 8890
        published: 8890
        protocol: udp
        mode: host          # SRT listener — Box empurra streams aqui
      - target: 8889
        published: 8889
        protocol: tcp
        mode: host          # WebRTC HTTP signaling (WHEP)
      - target: 8189
        published: 8189
        protocol: udp
        mode: host          # WebRTC ICE / RTP UDP
      - target: 8888
        published: 8888
        protocol: tcp
        mode: host          # HLS LL fallback
      - target: 8556
        published: 8556
        protocol: tcp
        mode: host          # RTSP (legado/compat) — 8554 já é go2rtc
    networks:
      icv_net:
        aliases:
          - mediamtx
    deploy:
      replicas: 1
      placement:
        constraints: [node.role == manager]
      restart_policy:
        condition: on-failure
        delay: 10s
        max_attempts: 5
      resources:
        limits:
          memory: 768M
